<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fire Emblem Average Stats Interactive Dashboard</title>
    <!-- Modern Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-main: #0b0f19;
            --bg-sidebar: #111827;
            --bg-card: rgba(22, 30, 49, 0.7);
            --bg-card-hover: rgba(30, 41, 69, 0.85);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --accent-primary: #3b82f6; /* Blue */
            --accent-secondary: #8b5cf6; /* Purple */
            --accent-glow: rgba(59, 130, 246, 0.15);
            
            --stat-hp: #ef4444;
            --stat-str: #f97316;
            --stat-mag: #a855f7;
            --stat-skl: #3b82f6;
            --stat-spd: #10b981;
            --stat-lck: #eab308;
            --stat-def: #6366f1;
            --stat-res: #ec4899;
            --stat-bld: #8b5cf6;
            --stat-mov: #f43f5e;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            overflow: hidden;
            height: 100vh;
            display: flex;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
        }

        /* --- App Layout --- */
        .sidebar {
            width: 380px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            height: 100%;
            flex-shrink: 0;
        }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow-y: auto;
            background: radial-gradient(circle at 50% 0%, rgba(30, 41, 79, 0.25) 0%, rgba(11, 15, 25, 0) 70%);
        }

        /* --- Sidebar Styles --- */
        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border-color);
        }

        .game-select-container {
            position: relative;
            width: 100%;
        }

        .game-select {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 16px;
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            outline: none;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%239ca3af'%3E%3Cpath d='M7 10l5 5 5-5H7z'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
            transition: all 0.2s ease;
        }

        .game-select:focus, .game-select:hover {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--accent-primary);
            box-shadow: 0 0 12px var(--accent-glow);
        }

        .sidebar-title {
            font-size: 1.3rem;
            background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 4px;
        }

        .sidebar-subtitle {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .sidebar-search-box {
            padding: 16px 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .search-input-wrapper {
            position: relative;
            width: 100%;
        }

        .search-input {
            width: 100%;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 12px 10px 36px;
            color: var(--text-primary);
            font-size: 0.9rem;
            outline: none;
            transition: all 0.2s ease;
        }

        .search-input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 2px var(--accent-glow);
            background-color: rgba(255, 255, 255, 0.08);
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            fill: var(--text-secondary);
            pointer-events: none;
        }

        .filters-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .filter-select {
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            font-size: 0.8rem;
            padding: 6px 8px;
            border-radius: 6px;
            outline: none;
            cursor: pointer;
        }

        .filter-select:focus {
            border-color: var(--accent-primary);
        }

        .character-list {
            flex-grow: 1;
            overflow-y: auto;
            padding: 16px 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .character-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background-color: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .character-item:hover {
            background-color: var(--bg-card-hover);
            border-color: var(--border-hover);
            transform: translateY(-1px);
        }

        .character-item.active {
            background-color: var(--bg-card-hover);
            border-color: var(--accent-primary);
            box-shadow: 0 0 12px var(--accent-glow);
            position: relative;
        }

        .character-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 15%;
            height: 70%;
            width: 4px;
            background: linear-gradient(to bottom, var(--accent-primary), var(--accent-secondary));
            border-radius: 0 4px 4px 0;
        }

        .char-item-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .char-item-name {
            font-weight: 500;
            font-size: 0.95rem;
        }

        .char-item-class {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .char-item-level-badge {
            background-color: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }

        .char-item-gender-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 8px;
            display: inline-block;
        }

        .gender-female {
            background-color: #f472b6;
        }

        .gender-male {
            background-color: #60a5fa;
        }

        /* --- Main Content Header / Hero Banner --- */
        .char-hero {
            padding: 32px 48px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(to bottom, rgba(17, 24, 39, 0.4), transparent);
        }

        .char-hero-title-group {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .char-hero-name {
            font-size: 2.2rem;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        .char-hero-badges {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-top: 8px;
        }

        .hero-badge {
            font-size: 0.8rem;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 500;
        }

        .hero-badge-gender {
            background-color: rgba(244, 114, 182, 0.1);
            border: 1px solid rgba(244, 114, 182, 0.2);
            color: #f472b6;
        }

        .hero-badge-gender.male {
            background-color: rgba(96, 165, 250, 0.1);
            border: 1px solid rgba(96, 165, 250, 0.2);
            color: #60a5fa;
        }

        .hero-badge-class {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .hero-badge-level {
            background-color: rgba(234, 179, 8, 0.1);
            border: 1px solid rgba(234, 179, 8, 0.2);
            color: #eab308;
        }

        /* --- Personal Bases & Growths Panel --- */
        .char-details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            padding: 24px 48px;
            gap: 32px;
        }

        .stat-card-panel {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            backdrop-filter: blur(16px);
        }

        .panel-title {
            font-size: 1.1rem;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title-desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            font-weight: 400;
        }

        .personal-stats-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .personal-stat-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .stat-label-col {
            width: 80px;
            font-weight: 500;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .stat-bar-wrapper {
            flex-grow: 1;
            background-color: rgba(255, 255, 255, 0.05);
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .stat-bar-fill {
            height: 100%;
            border-radius: 4px;
            width: 0%; /* Animated via JS */
            transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stat-value-col {
            width: 45px;
            text-align: right;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* --- Tabs --- */
        .tabs-container {
            padding: 0 48px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            gap: 24px;
        }

        .tab-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-family: 'Outfit', sans-serif;
            font-size: 1.05rem;
            font-weight: 500;
            padding: 14px 4px;
            cursor: pointer;
            position: relative;
            outline: none;
            transition: color 0.2s ease;
        }

        .tab-btn:hover {
            color: var(--text-primary);
        }

        .tab-btn.active {
            color: var(--accent-primary);
            font-weight: 600;
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(to right, var(--accent-primary), var(--accent-secondary));
            border-radius: 3px 3px 0 0;
        }

        /* --- Views Content --- */
        .view-section {
            padding: 32px 48px 48px 48px;
            display: none;
        }

        .view-section.active {
            display: block;
        }

        /* --- Reclass List & Table Style --- */
        .reclass-table-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .reclass-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .reclass-table th {
            background-color: rgba(0, 0, 0, 0.2);
            padding: 14px 18px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            user-select: none;
            transition: all 0.2s ease;
        }

        .reclass-table th:hover {
            background-color: rgba(255, 255, 255, 0.04);
            color: var(--text-primary);
        }

        .reclass-table td {
            padding: 12px 18px;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            transition: background-color 0.2s ease;
        }

        .reclass-table tr:last-child td {
            border-bottom: none;
        }

        .reclass-table tr:hover td {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .reclass-table tr.selected td {
            background-color: rgba(59, 130, 246, 0.08);
            border-bottom-color: rgba(59, 130, 246, 0.2);
        }

        .class-td-name {
            font-weight: 600;
            color: #60a5fa;
            cursor: pointer;
        }

        .class-td-path {
            font-size: 0.75rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .cap-cell {
            color: #f87171;
            font-weight: 700;
        }

        .max-lv-badge {
            font-size: 0.75rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            display: inline-block;
        }

        .max-lv-badge.promo {
            background-color: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.2);
            color: #c084fc;
        }

        .max-lv-badge.special {
            background-color: rgba(16, 185, 129, 0.1);
            border-color: rgba(16, 185, 129, 0.2);
            color: #34d399;
        }

        /* --- SVG Chart Section --- */
        .chart-controls-panel {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: center;
        }

        .chart-control-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
            font-weight: 600;
            width: 100%;
        }

        .stat-checkbox-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
            background-color: rgba(255, 255, 255, 0.02);
            transition: all 0.2s ease;
        }

        .stat-checkbox-label:hover {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: var(--border-hover);
        }

        .stat-checkbox-label.checked {
            background-color: var(--accent-glow);
            border-color: var(--accent-primary);
            color: #60a5fa;
        }

        .stat-checkbox {
            display: none;
        }

        .chart-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .svg-chart {
            width: 100%;
            height: 420px;
            overflow: visible;
        }

        /* --- Simulator Section --- */
        .simulator-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 32px;
        }

        .simulator-selector-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            height: fit-content;
        }

        .simulator-select-wrapper {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .sim-class-item {
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: rgba(255, 255, 255, 0.02);
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sim-class-item:hover {
            border-color: var(--border-hover);
            background-color: rgba(255, 255, 255, 0.04);
        }

        .sim-class-item.active {
            border-color: var(--accent-primary);
            background-color: var(--accent-glow);
            color: #60a5fa;
            font-weight: 600;
        }

        .simulator-log-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 500px;
        }

        .sim-log-scroll {
            overflow-x: auto;
            flex-grow: 1;
            margin-top: 16px;
        }

        .sim-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .sim-table th {
            background-color: rgba(0, 0, 0, 0.2);
            padding: 10px 12px;
            font-size: 0.8rem;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .sim-table td {
            padding: 8px 12px;
            font-size: 0.85rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            font-family: monospace;
        }

        .sim-table tr.promo-row td {
            background-color: rgba(139, 92, 246, 0.05);
            border-top: 1.5px solid rgba(139, 92, 246, 0.3);
            border-bottom: 1.5px solid rgba(139, 92, 246, 0.3);
            font-weight: bold;
            color: #c084fc;
        }

        .sim-cap-badge {
            background-color: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #f87171;
            font-size: 0.65rem;
            padding: 1px 4px;
            border-radius: 3px;
            font-weight: 700;
            margin-left: 4px;
            display: inline-block;
        }

        /* --- Scrollbar Customization --- */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.1);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* --- BST Leaderboard Styles --- */
        .bst-dashboard-layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 32px;
        }

        .bst-class-selector-panel {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            height: fit-content;
        }

        .bst-class-grid {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 560px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .bst-class-card {
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: rgba(255, 255, 255, 0.02);
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .bst-class-card:hover {
            border-color: var(--border-hover);
            background-color: rgba(255, 255, 255, 0.04);
        }

        .bst-class-card.active {
            border-color: var(--accent-primary);
            background-color: var(--accent-glow);
            color: #60a5fa;
            font-weight: 600;
        }

        .bst-class-card-leader {
            font-size: 0.75rem;
            color: #fbbf24;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .bst-leaderboard-panel {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
        }

        .bst-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 12px;
            margin-bottom: 12px;
        }

        .bst-leaderboard-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
        }

        .bst-rank-item {
            display: flex;
            align-items: center;
            padding: 16px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            background-color: rgba(255, 255, 255, 0.01);
            transition: all 0.2s ease;
        }

        .bst-rank-item:hover {
            background-color: rgba(255, 255, 255, 0.03);
            border-color: var(--border-hover);
        }

        .bst-rank-item.leader {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.05) 0%, rgba(251, 191, 36, 0.02) 100%);
            border-color: rgba(245, 158, 11, 0.3);
        }

        .bst-rank-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            margin-right: 16px;
            flex-shrink: 0;
            background-color: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
        }

        .bst-rank-item.leader .bst-rank-badge {
            background-color: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .bst-rank-name-col {
            width: 140px;
            font-weight: 600;
            font-size: 1.05rem;
            font-family: 'Outfit', sans-serif;
            cursor: pointer;
            color: #60a5fa;
            transition: color 0.2s;
        }

        .bst-rank-name-col:hover {
            color: #93c5fd;
            text-decoration: underline;
        }

        .bst-rank-bst-col {
            display: flex;
            flex-direction: column;
            gap: 2px;
            width: 90px;
            margin-right: 24px;
        }

        .bst-rank-bst-val {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .bst-rank-item.leader .bst-rank-bst-val {
            color: #fbbf24;
        }

        .bst-rank-bst-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
        }

        .bst-rank-stats-grid {
            flex-grow: 1;
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 8px;
        }

        .bst-rank-stat-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 6px;
            padding: 6px 4px;
            border: 1px solid rgba(255, 255, 255, 0.02);
        }

        .bst-rank-stat-name {
            font-size: 0.65rem;
            color: var(--text-secondary);
            margin-bottom: 2px;
        }

        .bst-rank-stat-val {
            font-size: 0.85rem;
            font-weight: 600;
            font-family: monospace;
        }

        .bst-rank-stat-val.capped {
            color: #f87171;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <!-- --- Sidebar --- -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h1 class="sidebar-title" style="margin-bottom: 12px;">FE Average Stats</h1>
            <div class="game-select-container">
                <select id="game-selector" class="game-select" onchange="switchGame(this.value)">
                    <option value="fe5">FE5: Thracia 776</option>
                    <option value="fe6">FE6: The Binding Blade</option>
                    <option value="fe7">FE7: The Blazing Blade</option>
                    <option value="fe8">FE8: The Sacred Stones</option>
                    <option value="fe9">FE9: Path of Radiance</option>
                    <option value="fe10">FE10: Radiant Dawn</option>
                    <option value="fe11">FE11: Shadow Dragon</option>
                    <option value="fe12">FE12: Heroes of Light & Shadow</option>
                </select>
            </div>
        </div>
        
        <div class="sidebar-search-box">
            <div class="search-input-wrapper">
                <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="text" id="search-bar" class="search-input" placeholder="Search characters...">
            </div>
            <div class="filters-grid">
                <select id="filter-gender" class="filter-select">
                    <option value="all">All Genders</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                </select>
                <select id="filter-pool" class="filter-select">
                    <option value="all">All Classes</option>
                    <option value="cavalry">Cavalry/Flyer</option>
                    <option value="magic">Magic/Staff</option>
                    <option value="infantry">Infantry/Melee</option>
                    <option value="special">Special Class</option>
                </select>
            </div>
        </div>

        <div class="character-list" id="char-list-container">
            <!-- Loaded dynamically in JS -->
        </div>
    </div>

    <!-- --- Main Content View --- -->
    <div class="main-content">
        <!-- Hero Header -->
        <div class="char-hero">
            <div>
                <div class="char-hero-title-group">
                    <h2 class="char-hero-name" id="hero-char-name">Marth</h2>
                </div>
                <div class="char-hero-badges">
                    <span class="hero-badge hero-badge-gender" id="hero-gender">Male</span>
                    <span class="hero-badge hero-badge-class" id="hero-default-class">Lord</span>
                    <span class="hero-badge hero-badge-level" id="hero-join-level">Base Level: 1</span>
                </div>
            </div>
        </div>

        <!-- Personal Stats Progress Bars -->
        <div class="char-details-grid">
            <div class="stat-card-panel">
                <div class="panel-title">
                    <span>Personal Base Stats</span>
                    <span class="panel-title-desc">In-game absolute stats before class modifiers</span>
                </div>
                <div class="personal-stats-list" id="personal-bases-container">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <div class="stat-card-panel">
                <div class="panel-title">
                    <span>Personal Growth Rates</span>
                    <span class="panel-title-desc">Character-specific raw percentages</span>
                </div>
                <div class="personal-stats-list" id="personal-growths-container">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab('reclass-list-view', this)">Reclass Statistics</button>
            <button class="tab-btn" onclick="switchTab('visual-chart-view', this)">Visual Comparison Chart</button>
            <button class="tab-btn" onclick="switchTab('simulator-view', this)">Level Growth Simulator</button>
            <button class="tab-btn" onclick="switchTab('bst-leaderboard-view', this)">BST Leaderboard</button>
        </div>

        <!-- VIEW 1: Reclass List and Table -->
        <div id="reclass-list-view" class="view-section active">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 16px; flex-wrap: wrap;">
                <div>
                    <h3 style="font-size: 1.2rem; margin-bottom: 6px; font-family: 'Outfit', sans-serif;">Calculated Average Stats at Max Level</h3>
                    <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0;">This table lists calculated stats at final max level. Click headers to sort. Select a class to view details.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 12px; background: rgba(255, 255, 255, 0.02); padding: 8px 16px; border-radius: 10px; border: 1px solid var(--border-color);">
                    <span style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Class Tier:</span>
                    <select id="filter-table-tier" class="filter-select" onchange="renderReclassTable(currentCharacterName)" style="background-color: rgba(0, 0, 0, 0.3); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.8rem; padding: 6px 12px; border-radius: 6px; outline: none; cursor: pointer; transition: border-color 0.2s;">
                        <option value="all">All Classes</option>
                        <option value="promoted">Promoted Only</option>
                        <option value="base">Base / Unpromoted</option>
                        <option value="special">Special Only</option>
                    </select>
                </div>
            </div>
            
            <div class="reclass-table-card">
                <table class="reclass-table">
                    <thead>
                        <tr id="table-headers">
                            <th onclick="handleHeaderClick('class')">Class Path <span id="sort-icon-class"></span></th>
                            <th onclick="handleHeaderClick('level')">Max Level <span id="sort-icon-level"></span></th>
                            <th onclick="handleHeaderClick('bst')">BST <span id="sort-icon-bst"></span></th>
                            <th onclick="handleHeaderClick('HP')">HP <span id="sort-icon-HP"></span></th>
                            <th onclick="handleHeaderClick('Str')">Str <span id="sort-icon-Str"></span></th>
                            <th onclick="handleHeaderClick('Mag')">Mag <span id="sort-icon-Mag"></span></th>
                            <th onclick="handleHeaderClick('Skl')">Skl <span id="sort-icon-Skl"></span></th>
                            <th onclick="handleHeaderClick('Spd')">Spd <span id="sort-icon-Spd"></span></th>
                            <th onclick="handleHeaderClick('Lck')">Lck <span id="sort-icon-Lck"></span></th>
                            <th onclick="handleHeaderClick('Def')">Def <span id="sort-icon-Def"></span></th>
                            <th onclick="handleHeaderClick('Res')">Res <span id="sort-icon-Res"></span></th>
                        </tr>
                    </thead>
                    <tbody id="reclass-table-body">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- VIEW 2: Visual Comparison Chart -->
        <div id="visual-chart-view" class="view-section">
            <div class="chart-controls-panel" id="chart-checkboxes-container">
                <!-- Dynamically loaded -->
            </div>
            
            <div class="chart-card">
                <svg id="svg-comparison-chart" class="svg-chart"></svg>
            </div>
        </div>

        <!-- VIEW 3: Interactive Growth Simulator -->
        <div id="simulator-view" class="view-section">
            <div class="simulator-layout">
                <!-- Class Selection Cards -->
                <div class="simulator-selector-card">
                    <h4 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">Select Target Class</h4>
                    <div class="simulator-select-wrapper" id="sim-class-list-container">
                        <!-- Loaded dynamically -->
                    </div>
                </div>
                
                <!-- Detailed Progression Log Table -->
                <div class="simulator-log-card">
                    <h3 style="font-size: 1.2rem; font-family: 'Outfit', sans-serif;" id="sim-log-title">Level-up Growth Log: Marth as Lord</h3>
                    <p style="color: var(--text-secondary); font-size: 0.85rem;" id="sim-log-desc">Simulates growths level-by-level, verifying cap clamps at each step.</p>
                    
                    <div class="sim-log-scroll">
                        <table class="sim-table">
                            <thead>
                                <tr>
                                    <th>Level</th>
                                    <th>Class</th>
                                    <th>HP</th>
                                    <th>Str</th>
                                    <th>Mag</th>
                                    <th>Skl</th>
                                    <th>Spd</th>
                                    <th>Lck</th>
                                    <th>Def</th>
                                    <th>Res</th>
                                </tr>
                            </thead>
                            <tbody id="sim-table-body">
                                <!-- Loaded dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW 4: BST Leaderboard -->
        <div id="bst-leaderboard-view" class="view-section">
            <h3 style="font-size: 1.2rem; margin-bottom: 8px; font-family: 'Outfit', sans-serif;">Direct Promotion BST Leaderboard</h3>
            <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 24px;">
                Comparing characters when they stick to their default starting classes and promote directly (using the Elysian Whip Falcon Knight path for Pegasus Knights). 
                BST (Base Stat Total) is the sum of all 8 average stats at final maximum level (Level 20/20 or Level 30).
            </p>

            <div class="bst-dashboard-layout">
                <!-- Left: Class Grid/Selector -->
                <div class="bst-class-selector-panel">
                    <h4 style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 12px;">Final Classes</h4>
                    <div class="bst-class-grid" id="bst-class-grid-container">
                        <!-- Class cards generated dynamically -->
                    </div>
                </div>

                <!-- Right: Leaderboard -->
                <div class="bst-leaderboard-panel">
                    <div class="bst-panel-header">
                        <h3 style="font-size: 1.3rem; font-family: 'Outfit', sans-serif;" id="bst-class-title">Paladin Leaderboard</h3>
                        <span class="max-lv-badge promo" id="bst-class-max-lv">Max Lv: 20/20</span>
                    </div>
                    
                    <p style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 20px;" id="bst-class-desc">Characters who promote directly to Paladin, ranked by their final max-level BST.</p>

                    <div class="bst-leaderboard-list" id="bst-leaderboard-list-container">
                        <!-- Rank items loaded dynamically -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- --- Load JS Data --- -->
    <script src="average_stats_data.js"></script>

    <!-- --- Core JS Application Logic --- -->
    <script>
        const STATS = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Res"];
        const STAT_COLORS = {
            "HP": "var(--stat-hp)",
            "Str": "var(--stat-str)",
            "Mag": "var(--stat-mag)",

        let STATS = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Res"];
        let STAT_COLORS = {
            "HP": "var(--stat-hp)",
            "Str": "var(--stat-str)",
            "Mag": "var(--stat-mag)",
            "Skl": "var(--stat-skl)",
            "Spd": "var(--stat-spd)",
            "Lck": "var(--stat-lck)",
            "Def": "var(--stat-def)",
            "Res": "var(--stat-res)",
            "Bld": "var(--stat-bld)",
            "Mov": "var(--stat-mov)"
        };

        // --- Active Game Campaign State ---
        let currentGame = "fe6";
        let activeStatsData = AVERAGE_STATS_DATA[currentGame];
        let activeRawDb = FE6_RAW_DATABASE;
        
        // --- FE12 Reclass Pools ---
        const BASE_CLASSES = new Set([
            "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
            "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage", "Barbarian"
        ]);
        const PROMOTED_CLASSES = new Set([
            "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
            "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
        ]);
        const SPECIAL_CLASSES = new Set([
            "Lord", "Thief", "Dancer", "Chameleon", "Manakete", "Ballistician"
        ]);

        const CLASS_TO_GROWTH_GROUP = {
            "Lord": "Lord", "Pegasus Knight": "Peg / Falco / Draco Knight",
            "Falcon Knight": "Peg / Falco / Draco Knight", "Dracoknight": "Peg / Falco / Draco Knight",
            "Cavalier": "Cavalier / Paladin", "Paladin": "Cavalier / Paladin",
            "Knight": "Knight / General", "General": "Knight / General",
            "Archer": "Archer / Sniper", "Sniper": "Archer / Sniper",
            "Mercenary": "Mercenary / Hero", "Hero": "Mercenary / Hero",
            "Myrmidon": "Myrmidon / Swordmaster", "Swordmaster": "Myrmidon / Swordmaster",
            "Fighter": "Fighter / Warrior", "Warrior": "Fighter / Warrior",
            "Hunter": "Hunter / Horseman", "Horseman": "Hunter / Horseman",
            "Pirate": "Pirate / Berserker", "Berserker": "Pirate / Berserker",
            "Barbarian": "Barbarian", "Dark Mage": "Dark Mage / Sorcerer",
            "Sorcerer": "Dark Mage / Sorcerer", "Mage": "Mage", "Sage": "Sage",
            "Curate": "Curate / Cleric", "Cleric": "Curate / Cleric", "Bishop": "Bishop",
            "Thief": "Thief / Dancer", "Dancer": "Thief / Dancer", "Manakete": "Manakete",
            "Ballistician": "Ballistician", "Chameleon": "Chameleon",
            "Soldier": "Soldier / Emperor", "Emperor": "Soldier / Emperor"
        };

        const PROMOTION_MAP = {
            "Falcon Knight": "Pegasus Knight", "Dracoknight": "Pegasus Knight",
            "Paladin": "Cavalier", "Sniper": "Archer", "Swordmaster": "Myrmidon",
            "Sage": "Mage", "Bishop": "Curate", "General": "Knight", "Hero": "Mercenary",
            "Warrior": "Fighter", "Horseman": "Hunter", "Berserker": "Pirate", "Sorcerer": "Dark Mage"
        };

        // --- FE6 (GBA) Configurations ---
        const FE6_FEMALE_CHARACTERS = new Set([
            "Elen", "Ellen", "Clarine", "Sue", "Wendy", "Fir", "Fir (HM)", "Tate", "Tate (HM)", 
            "Lalum", "Echidna", "Cath", "Cath (HM)", "Miredy", "Miredy (HM)", "Sofiya", "Sophia",
            "Igrene", "Fa", "Niime", "Juno", "Brunya", "Guinevere", "Lilina", "Thany", "Cecilia", "Dorothy"
        ]);
        const FE6_SPECIAL_CLASSES = new Set(["Thief", "Bard", "Dancer", "Mamkute", "Transporter", "King"]);
        const FE6_PROMOTION_MAP = {
            "Lord": "Master Lord",
            "Mercenary": "Hero",
            "Myrmidon": "Swordmaster",
            "Cavalier": "Paladin",
            "Knight": "General",
            "Fighter": "Warrior",
            "Bandit": "Berserker",
            "Brigand": "Berserker",
            "Pirate": "Berserker",
            "Archer": "Sniper",
            "Nomad": "Nomadic Trooper",
            "Pegasus Knight": "Falcon Knight",
            "Wyvern Rider": "Wyvern Lord",
            "Mage": "Sage",
            "Shaman": "Druid",
            "Priest": "Bishop",
            "Cleric": "Bishop",
            "Troubadour": "Valkyria"
        };

        function getFE6GenderedClass(clsName, isFemale) {
            const genderSuffix = isFemale ? " (F)" : " (M)";
            const genderDistinguished = new Set([
                "Mercenary", "Hero", "Myrmidon", "Swordmaster", "Cavalier", "Paladin",
                "Knight", "General", "Archer", "Sniper", "Nomad", "Nomadic Trooper",
                "Wyvern Rider", "Wyvern Lord", "Mage", "Sage", "Shaman", "Druid", "Priest", "Bishop"
            ]);
            if (genderDistinguished.has(clsName)) {
                return clsName + genderSuffix;
            }
            if (clsName === "Cleric") return "Priest (F)";
            if (clsName === "Nomadic Trooper" || clsName === "Nomad Trooper") {
                return `Nomad Trooper${genderSuffix}`;
            }
            return clsName;
        }

        function isFE6Promoted(clsName) {
            const gbaPromoted = new Set([
                "Master Lord", "Hero", "Swordmaster", "Paladin", "General", "Warrior", "Berserker",
                "Sniper", "Nomadic Trooper", "Nomad Trooper", "Falcon Knight", "Wyvern Lord", "Sage", "Druid", "Bishop", "Valkyria", "Valkyrie"
            ]);
            return gbaPromoted.has(clsName);
        }

        function getFE6Caps(clsName, isFemale, capsDb) {
            const gendered = getFE6GenderedClass(clsName, isFemale);
            if (capsDb[gendered]) return capsDb[gendered];
            if (capsDb[clsName]) return capsDb[clsName];
            return capsDb["Non-promoted"] || Object.fromEntries(STATS.map(s => [s, 20]));
        }

        function getFE6PromoGains(baseCls, promoCls, isFemale, promoGainsDb) {
            const genderedBase = getFE6GenderedClass(baseCls, isFemale);
            const genderedPromo = getFE6GenderedClass(promoCls, isFemale);
            const key = `${genderedBase} -> ${genderedPromo}`;
            if (promoGainsDb[key]) return promoGainsDb[key];
            const keyPlain = `${baseCls} -> ${promoCls}`;
            if (promoGainsDb[keyPlain]) return promoGainsDb[keyPlain];
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        // --- FE7 (GBA) Configurations ---
        const FE7_FEMALE_CHARACTERS = new Set([
            "Lyn", "Florina", "Serra", "Rebecca", "Priscilla", "Fiora", "Ninian", "Isadora", 
            "Farina", "Louise", "Nino", "Vaida", "Vaida HM", "Karla"
        ]);
        const FE7_SPECIAL_CLASSES = new Set(["Dancer", "Bard", "Transporter", "Archsage"]);
        const FE7_PROMOTION_MAP = {
            "Cavalier": "Paladin",
            "Knight": "General",
            "Mercenary": "Hero",
            "Myrmidon": "Swordmaster",
            "Thief": "Assassin",
            "Archer": "Sniper",
            "Nomad": "Nmd Trooper",
            "Pegasus Knight": "Falcoknight",
            "Wyvern Rider": "Wyvern Lord",
            "Mage": "Sage",
            "Monk": "Bishop",
            "Priest": "Bishop",
            "Cleric": "Bishop",
            "Shaman": "Druid",
            "Fighter": "Warrior",
            "Pirate": "Berserker",
            "Troubadour": "Valkyrie"
        };

        function getFE7GenderedClass(clsName, isFemale) {
            const genderSuffix = isFemale ? " (F)" : " (M)";
            if (["Paladin", "General", "Hero", "Swordmaster", "Sniper", "Nomad Trooper", "Nmd Trooper", "Wyvern Lord", "Sage", "Bishop", "Druid"].includes(clsName)) {
                return `${clsName}${genderSuffix}`;
            }
            return clsName;
        }

        function isFE7Promoted(clsName) {
            const promoted = new Set(Object.values(FE7_PROMOTION_MAP));
            const specialPromoted = new Set([
                "Blade Lord", "Knight Lord", "Great Lord", "Nomad Trooper", "Falcon Knight", "Assassin"
            ]);
            return promoted.has(clsName) || specialPromoted.has(clsName);
        }

        function getFE7Caps(clsName, isFemale, capsDb) {
            const gendered = getFE7GenderedClass(clsName, isFemale);
            if (capsDb[gendered]) return capsDb[gendered];
            if (capsDb[clsName]) return capsDb[clsName];
            return capsDb["Non-promoted"] || Object.fromEntries(STATS.map(s => [s, 20]));
        }

        function getFE7PromoGains(targetClass, isFemale, promoGainsDb) {
            const gendered = getFE7GenderedClass(targetClass, isFemale);
            if (promoGainsDb[gendered]) return promoGainsDb[gendered];
            if (promoGainsDb[targetClass]) return promoGainsDb[targetClass];
            if (targetClass === "Falcon Knight" && promoGainsDb["Falcoknight"]) {
                return promoGainsDb["Falcoknight"];
            }
            if (targetClass === "Nomad Trooper" && promoGainsDb["Nmd Trooper"]) {
                return promoGainsDb["Nmd Trooper"];
            }
            if (targetClass === "Nomad Trooper (F)" && promoGainsDb["Nmd Trooper (F)"]) {
                return promoGainsDb["Nmd Trooper (F)"];
            }
            if (targetClass === "Nomad Trooper (M)" && promoGainsDb["Nmd Trooper (M)"]) {
                return promoGainsDb["Nmd Trooper (M)"];
            }
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        function calculateFE7AvgStatsJS(charName, targetClass) {
            const charData = FE7_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const capsDb = FE7_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE7_RAW_DATABASE.classes.promo_gains;
            
            let currentStats = {};
            let history = [];
            
            if (FE7_SPECIAL_CLASSES.has(targetClass)) {
                const clsCaps = getFE7Caps(targetClass, isFemale, capsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.max(0, absBases[s]);
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
            else if (isFE7Promoted(targetClass)) {
                const isAlreadyPromoted = isFE7Promoted(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const baseCls = charData.default_class;
                    const baseCaps = getFE7Caps(baseCls, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, baseCls, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                        }
                        history.push([lv, baseCls, {...currentStats}]);
                    }
                    
                    const gains = getFE7PromoGains(targetClass, isFemale, promoGainsDb);
                    const promoCaps = getFE7Caps(targetClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push(["Promotion", targetClass, {...currentStats}]);
                    
                    for (let lv = 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, targetClass, {...currentStats}]);
                    }
                    return { classPath: `${baseCls} ➔ ${targetClass}`, finalClass: targetClass, finalLevel: "20/20", stats: currentStats, history: history };
                } else {
                    const promoCaps = getFE7Caps(targetClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, targetClass, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, targetClass, {...currentStats}]);
                    }
                    return { classPath: targetClass, finalClass: targetClass, finalLevel: `${joinLv} ➔ 20`, stats: currentStats, history: history };
                }
            }
            else {
                const baseCaps = getFE7Caps(targetClass, isFemale, capsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.max(0, absBases[s]);
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
        }

        // --- FE8 (GBA) Configurations ---
        const FE8_FEMALE_CHARACTERS = new Set([
            "Eirika", "Vanessa", "Neimi", "Lute", "Natasha", "Tana", "Amelia", "Marisa", "L'Arachel", "Myrrh", "Syrene", "Ismaire", "Selena"
        ]);
        const FE8_SPECIAL_CLASSES = new Set(["Dancer", "Manakete"]);

        function isFE8Promoted(clsName) {
            const baseName = clsName.split("(")[0].trim();
            if (["Lord", "Dancer", "Manakete", "Journeyman", "Recruit", "Pupil", "Journeyman (2)", "Recruit (2)", "Pupil (2)"].includes(baseName)) {
                return false;
            }
            if (["Cavalier", "Knight", "Thief", "Mercenary", "Myrmidon", "Archer", "Wyvern Rider", "Pegasus Knight", "Mage", "Shaman", "Priest", "Monk", "Cleric", "Troubadour", "Fighter", "Pirate"].includes(baseName)) {
                return false;
            }
            return true;
        }

        function getFE8Caps(clsName, isFemale, capsDb) {
            if (capsDb[clsName]) return capsDb[clsName];
            const genderSuffix = isFemale ? " (F)" : " (M)";
            if (capsDb[`${clsName}${genderSuffix}`]) return capsDb[`${clsName}${genderSuffix}`];
            const cleanName = clsName.split("(")[0].trim();
            if (capsDb[cleanName]) return capsDb[cleanName];
            if (capsDb[`${cleanName}${genderSuffix}`]) return capsDb[`${cleanName}${genderSuffix}`];
            return {
                "HP": 60, "Str": 20, "Mag": 20, "Skl": 20, "Spd": 20, "Lck": 30, "Def": 20, "Res": 20
            };
        }

        function getFE8PromoGains(baseCls, promoCls, promoGainsDb) {
            const key = `${baseCls} -> ${promoCls}`;
            if (promoGainsDb[key]) return promoGainsDb[key];
            const cleanPromo = promoCls.split("(")[0].trim();
            const key2 = `${baseCls} -> ${cleanPromo}`;
            if (promoGainsDb[key2]) return promoGainsDb[key2];
            const cleanBase = baseCls.split("(")[0].trim();
            const key3 = `${cleanBase} -> ${cleanPromo}`;
            if (promoGainsDb[key3]) return promoGainsDb[key3];
            if (cleanBase === "Pupil" && cleanPromo === "Shaman") {
                if (promoGainsDb["Pupil -> Shaman (M)"]) {
                    return promoGainsDb["Pupil -> Shaman (M)"];
                }
            }
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        function calculateFE8AvgStatsJS(charName, targetClass) {
            const charData = FE8_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const capsDb = FE8_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE8_RAW_DATABASE.classes.promo_gains;
            
            const precomputedClass = activeStatsData[charName].classes[targetClass];
            if (!precomputedClass) {
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: Object.fromEntries(STATS.map(s => [s, absBases[s] || 0])), history: [] };
            }
            
            const path = precomputedClass.class_path.split(" -> ");
            let currentStats = {};
            let history = [];
            for (const s of STATS) {
                currentStats[s] = Math.max(0, absBases[s]);
            }
            
            const isTrainee = ["Journeyman", "Recruit", "Pupil"].includes(charData.default_class);
            
            if (isTrainee) {
                const t1Class = path[0];
                const t1Caps = getFE8Caps(t1Class, isFemale, capsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.min(t1Caps[s], currentStats[s]);
                }
                history.push([joinLv, t1Class, {...currentStats}]);
                
                for (let lv = joinLv + 1; lv <= 10; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(t1Caps[s], currentStats[s]);
                    }
                    history.push([lv, t1Class, {...currentStats}]);
                }
                
                if (path.length > 1) {
                    const t2Class = path[1];
                    const t2Caps = getFE8Caps(t2Class, isFemale, capsDb);
                    const gains = getFE8PromoGains(t1Class, t2Class, promoGainsDb);
                    
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(t2Caps[s], currentStats[s]);
                    }
                    history.push(["10/1", t2Class, {...currentStats}]);
                    
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(t2Caps[s], currentStats[s]);
                        }
                        history.push([`10/${lv}`, t2Class, {...currentStats}]);
                    }
                    
                    if (path.length > 2) {
                        const t3Class = path[2];
                        const t3Caps = getFE8Caps(t3Class, isFemale, capsDb);
                        const gains2 = getFE8PromoGains(t2Class, t3Class, promoGainsDb);
                        
                        for (const s of STATS) {
                            currentStats[s] += gains2[s];
                            currentStats[s] = Math.min(t3Caps[s], currentStats[s]);
                        }
                        history.push(["10/20/1", t3Class, {...currentStats}]);
                        
                        for (let lv = 2; lv <= 20; lv++) {
                            for (const s of STATS) {
                                const growthRate = Math.max(0, baseGrowths[s]);
                                currentStats[s] += growthRate / 100.0;
                                currentStats[s] = Math.min(t3Caps[s], currentStats[s]);
                            }
                            history.push([`10/20/${lv}`, t3Class, {...currentStats}]);
                        }
                        
                        return {
                            classPath: path.join(" ➔ "),
                            finalClass: t3Class,
                            finalLevel: "10/20/20",
                            stats: currentStats,
                            history: history
                        };
                    } else {
                        return {
                            classPath: path.join(" ➔ "),
                            finalClass: t2Class,
                            finalLevel: "10/20",
                            stats: currentStats,
                            history: history
                        };
                    }
                } else {
                    return {
                        classPath: t1Class,
                        finalClass: t1Class,
                        finalLevel: "10",
                        stats: currentStats,
                        history: history
                    };
                }
            } else {
                const startClass = path[0];
                const isAlreadyPromoted = isFE8Promoted(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const t1Caps = getFE8Caps(startClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(t1Caps[s], currentStats[s]);
                    }
                    history.push([joinLv, startClass, {...currentStats}]);
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(t1Caps[s], currentStats[s]);
                        }
                        history.push([lv, startClass, {...currentStats}]);
                    }
                    
                    if (path.length > 1) {
                        const promoClass = path[1];
                        const promoCaps = getFE8Caps(promoClass, isFemale, capsDb);
                        const gains = getFE8PromoGains(startClass, promoClass, promoGainsDb);
                        
                        for (const s of STATS) {
                            currentStats[s] += gains[s];
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push(["20/1", promoClass, {...currentStats}]);
                        
                        for (let lv = 2; lv <= 20; lv++) {
                            for (const s of STATS) {
                                const growthRate = Math.max(0, baseGrowths[s]);
                                currentStats[s] += growthRate / 100.0;
                                currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                            }
                            history.push([`20/${lv}`, promoClass, {...currentStats}]);
                        }
                        
                        return {
                            classPath: path.join(" ➔ "),
                            finalClass: promoClass,
                            finalLevel: "20/20",
                            stats: currentStats,
                            history: history
                        };
                    } else {
                        return {
                            classPath: startClass,
                            finalClass: startClass,
                            finalLevel: "20",
                            stats: currentStats,
                            history: history
                        };
                    }
                } else {
                    const promoCaps = getFE8Caps(startClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push([joinLv, startClass, {...currentStats}]);
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, startClass, {...currentStats}]);
                    }
                    
                    return {
                        classPath: startClass,
                        finalClass: startClass,
                        finalLevel: `${joinLv} ➔ 20`,
                        stats: currentStats,
                        history: history
                    };
                }
            }
        }

        // --- FE9 (Path of Radiance) Configurations ---
        const FE9_FEMALE_CHARACTERS = new Set([
            "Titania", "Mia", "Ilyana", "Marcia", "Mist", "Lethe", "Nephenee", 
            "Jill", "Astrid", "Tanith", "Calill", "Lucia", "Elincia", "Ena", "Leanne"
        ]);
        const FE9_SPECIAL_CLASSES = new Set([
            "Beast tribe (Cat)", "Beast tribe (Tiger)", "Beast tribe (Lion)", 
            "Bird tribe (Hawk)", "Bird tribe (Raven)", "Bird tribe (Heron)", 
            "Dragon tribe (Red)", "Dragon tribe (White)", "Thief"
        ]);
        const FE9_PROMOTION_MAP = {
            "Ranger": "Lord",
            "Myrmidon": "Swordmaster",
            "Soldier": "Halberdier",
            "Fighter": "Warrior",
            "Archer": "Sniper",
            "Knight": "General",
            "Sword Knight": "Paladin",
            "Lance Knight": "Paladin",
            "Axe Knight": "Paladin",
            "Bow Knight": "Paladin",
            "Pegasus Knight": "Falcon Knight",
            "Wyvern Rider": "Wyvern Lord",
            "Mage": "Sage",
            "Priest": "Bishop",
            "Cleric": "Valkyrie",
            "Thief": "Assassin"
        };

        function isFE9Promoted(clsName) {
            const promoted = new Set([
                "Lord", "Hero", "Swordmaster", "Swordmaster (M)", "Swordmaster (F)", 
                "Halberdier", "Warrior", "Sniper", "General", "Paladin", "Paladin (M)", 
                "Paladin (F)", "Falcon Knight", "Wyvern Lord", "Wyvern Lord (M)", 
                "Wyvern Lord (F)", "Sage", "Bishop", "Valkyrie", "Assassin", "Assassin (M)", 
                "Berserker", "Princess Crimea"
            ]);
            return promoted.has(clsName);
        }

        function getFE9CapsKey(clsName, isFemale, charName) {
            if (charName === "Ike" && clsName === "Lord") {
                return "Lord / Hero";
            }
            if (charName === "Elincia") {
                return "Princess Crimea";
            }
            if (charName === "Tibarn") {
                return "Bird tribe (Tibarn)";
            }
            if (charName === "Naesala") {
                return "Bird tribe (Naesala)";
            }
            
            if (["Ranger", "Myrmidon", "Soldier", "Fighter", "Archer", "Knight", 
                 "Sword Knight", "Lance Knight", "Axe Knight", "Thief"].includes(clsName)) {
                return "Non-promoted physical";
            }
            if (clsName === "Bow Knight") {
                return isFemale ? "Horse Knight (F)" : "Non-promoted physical";
            }
            if (clsName === "Cleric" || clsName === "Priest") {
                return "Priest / Cleric";
            }
            
            if (clsName === "Swordmaster") {
                return isFemale ? "Swordmaster (F)" : "Swordmaster (M)";
            }
            if (clsName === "Paladin") {
                return isFemale ? "Paladin (F)" : "Paladin (M)";
            }
            if (clsName === "Wyvern Lord") {
                return isFemale ? "Wyvern Lord (F)" : "Wyvern Lord (M)";
            }
            if (clsName === "Assassin") {
                return isFemale ? "Assassin (F)" : "Assassin (M)";
            }
            
            if (clsName === "Beast tribe (Cat)") {
                return isFemale ? "Beast tribe (Cat F)" : "Beast tribe (Cat M)";
            }
            if (clsName === "Beast tribe (Tiger)") {
                return "Beast tribe (Tiger)";
            }
            if (clsName === "Beast tribe (Lion)") {
                return charName === "Giffca" ? "Lion" : "Beast tribe (Lion)";
            }
            if (clsName === "Bird tribe (Hawk)") {
                return "Bird tribe (Hawk)";
            }
            if (clsName === "Bird tribe (Raven)") {
                return "Bird tribe (Raven)";
            }
            if (clsName === "Bird tribe (Heron)") {
                return isFemale ? "Bird tribe (Heron F)" : "Bird tribe (Heron M)";
            }
            if (clsName === "Dragon tribe (Red)") {
                return isFemale ? "Dragon tribe (Red F)" : "Dragon tribe (Red M)";
            }
            if (clsName === "Dragon tribe (White)") {
                return "Dragon tribe (White)";
            }
                
            return clsName;
        }

        function getFE9Caps(clsName, isFemale, capsDb, charName) {
            const capsKey = getFE9CapsKey(clsName, isFemale, charName);
            if (capsDb[capsKey]) return capsDb[capsKey];
            if (capsDb[clsName]) return capsDb[clsName];
            return Object.fromEntries(STATS.map(s => [s, 20]));
        }

        function getFE9PromoGains(baseCls, promoCls, isFemale, promoGainsDb) {
            let mappedBase = baseCls;
            let mappedPromo = promoCls;
            
            if (baseCls === "Mage") {
                mappedBase = isFemale ? "Mage (F)" : "Mage (M)";
                mappedPromo = isFemale ? "Sage (F)" : "Sage (M)";
            } else if (baseCls === "Myrmidon") {
                mappedBase = isFemale ? "Myrmidon (F)" : "Myrmidon (M)";
                mappedPromo = isFemale ? "Swordmaster (F)" : "Swordmaster (M)";
            } else if (baseCls === "Soldier") {
                mappedBase = isFemale ? "Soldier (F)" : "Soldier";
                mappedPromo = isFemale ? "Halberdier (F)" : "Halberdier";
            } else if (baseCls === "Wyvern Rider") {
                mappedBase = isFemale ? "Wyvern Rider (F)" : "Wyvern Rider";
                mappedPromo = isFemale ? "Wyvern Lord (F)" : "Wyvern Lord";
            } else if (baseCls === "Priest") {
                mappedBase = "Priest";
                mappedPromo = "Bishop (M)";
            } else if (baseCls === "Thief") {
                mappedBase = "Thief";
                mappedPromo = "Assassin (M)";
            } else if (baseCls === "Sword Knight") {
                mappedBase = "Sword Knight (M)";
                mappedPromo = "Paladin (M)";
            } else if (baseCls === "Lance Knight") {
                mappedBase = "Lance Knight (M)";
                mappedPromo = "Paladin (M)";
            } else if (baseCls === "Axe Knight") {
                mappedBase = "Axe Knight (M)";
                mappedPromo = "Paladin (M)";
            } else if (baseCls === "Bow Knight") {
                mappedBase = isFemale ? "Bow Knight (F)" : "Bow Knight";
                mappedPromo = isFemale ? "Paladin (F)" : "Paladin";
            }
            
            const key = `${mappedBase} -> ${mappedPromo}`;
            if (promoGainsDb[key]) return promoGainsDb[key];
            const keyPlain = `${baseCls} -> ${promoCls}`;
            if (promoGainsDb[keyPlain]) return promoGainsDb[keyPlain];
            
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        function calculateFE9AvgStatsJS(charName, targetClass) {
            const charData = FE9_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const capsDb = FE9_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE9_RAW_DATABASE.classes.promo_gains;
            
            let currentStats = {};
            let history = [];
            
            const capsKey = getFE9CapsKey(targetClass, isFemale, charName);
            const clsCaps = capsDb[capsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
            
            if (!isFE9Promoted(targetClass)) {
                for (const s of STATS) {
                    currentStats[s] = Math.max(0, absBases[s]);
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
            else if (isFE9Promoted(targetClass)) {
                const isAlreadyPromoted = isFE9Promoted(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const baseCls = charData.default_class;
                    const baseCapsKey = getFE9CapsKey(baseCls, isFemale, charName);
                    const baseCaps = capsDb[baseCapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                    
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, baseCls, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                        }
                        history.push([lv, baseCls, {...currentStats}]);
                    }
                    
                    const gains = getFE9PromoGains(baseCls, targetClass, isFemale, promoGainsDb);
                    const promoCapsKey = getFE9CapsKey(targetClass, isFemale, charName);
                    const promoCaps = capsDb[promoCapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push(["Promotion", targetClass, {...currentStats}]);
                    
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, targetClass, {...currentStats}]);
                    }
                    return { classPath: `${baseCls} ➔ ${targetClass}`, finalClass: targetClass, finalLevel: "20/20", stats: currentStats, history: history };
                } else {
                    const promoCapsKey = getFE9CapsKey(targetClass, isFemale, charName);
                    const promoCaps = capsDb[promoCapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, targetClass, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, targetClass, {...currentStats}]);
                    }
                    return { classPath: targetClass, finalClass: targetClass, finalLevel: `${joinLv} ➔ 20`, stats: currentStats, history: history };
                }
            }
        }

        // --- FE10 (Radiant Dawn) Configurations & Simulator ---
        const FE10_FEMALE_CHARACTERS = new Set([
            "Micaiah", "Laura", "Ilyana", "Meg", "Jill", "Fiona", "Vika", "Nailah",
            "Elincia", "Marcia", "Leanne", "Nephenee", "Heather", "Lucia", "Lethe",
            "Astrid", "Titania", "Mist", "Lyre", "Sigrun", "Tanith", "Sanaki", "Ena",
            "Mia", "Calill"
        ]);

        const FE10_LAGUZ_CLASSES = new Set([
            "Wolf", "Wolf Queen", "Cat", "Lion", "Lion King", "Tiger", "Hawk", "Hawk King", 
            "Raven", "Raven King", "Heron", "Red Dragon", "White Dragon", "Dragon Prince", "Dragon King"
        ]);

        const FE10_PROMOTION_MAP = {
            "Light Mage": "Light Sage",
            "Myrmidon": "Swordmaster",
            "Archer": "Sniper",
            "Fighter": "Warrior",
            "Priest": "Bishop",
            "Thunder Mage": "Thunder Sage",
            "Soldier": "Halberdier",
            "Armor Sword": "Sword General",
            "Dracoknight": "Dragonmaster",
            "Lance Knight": "Lance Paladin",
            
            "Light Sage": "Light Priestess",
            "Swordmaster": "Trueblade",
            "Sniper": "Marksman",
            "Warrior": "Reaver",
            "Bishop": "Saint",
            "Thunder Sage": "Arch Sage",
            "Halberdier": "Sentinel",
            "Sword General": "Marshall",
            "Lance General": "Marshall",
            "Axe General": "Marshall",
            "Dragonmaster": "Dragonlord",
            "Lance Paladin": "Silver Knight",
            "Axe Paladin": "Gold Knight",
            "Bow Paladin": "Silver Knight",
            "Blade Paladin": "Gold Knight",
            "Rogue": "Whisper",
            "Hero": "Vanguard",
            "Wind Sage": "Arch Sage",
            "Fire Sage": "Arch Sage",
            "Dark Sage": "Arch Sage",
            
            "Cleric": "Valkyrie",
        };

        function getFE10ClassTier(clsName) {
            const tier1 = new Set([
                "Light Mage", "Myrmidon", "Archer", "Fighter", "Priest", 
                "Thunder Mage", "Soldier", "Armor Sword", "Dracoknight", "Lance Knight"
            ]);
            if (tier1.has(clsName)) return 1;
            
            const tier2 = new Set([
                "Light Sage", "Swordmaster", "Sniper", "Warrior", "Bishop", 
                "Thunder Sage", "Halberdier", "Sword General", "Lance General", "Axe General",
                "Dragonmaster", "Lance Paladin", "Axe Paladin", "Bow Paladin", "Blade Paladin",
                "Rogue", "Hero", "Wind Sage", "Fire Sage", "Dark Sage", "Cleric"
            ]);
            if (tier2.has(clsName)) return 2;
            
            return 3;
        }

        function getFE10CapsKey(clsName, isFemale, charName) {
            if (clsName === "Arch Sage") {
                if (charName === "Ilyana") return "Arch Sage (Thunder, F)";
                if (charName === "Calill") return "Arch Sage (Fire, F)";
                if (charName === "Tormod" || charName === "Bastian") return "Arch Sage (Fire, M)";
                if (charName === "Soren") return "Arch Sage (Wind)";
                if (charName === "Pelleas") return "Arch Sage (Dark)";
                return "Arch Sage (Wind)";
            }
            
            if (clsName === "Marshall") {
                if (charName === "Meg") return "Marshall (Sword, F)";
                if (charName === "Brom") return "Marshall (Axe)";
                if (charName === "Tauroneo" || charName === "Gatrie") return "Marshall (Lance)";
                return "Marshall (Lance)";
            }
            
            if (clsName === "Gold Knight") {
                if (charName === "Kieran" || charName === "Titania") {
                    return isFemale ? "Gold Knight (Axe, F)" : "Gold Knight (Axe, M)";
                }
                return "Gold Knight (Sword)";
            }
            
            if (clsName === "Silver Knight") {
                if (charName === "Astrid") return "Silver Knight (Bow, F)";
                return isFemale ? "Silver Knight (Lance, F)" : "Silver Knight (Lance, M)";
            }
            
            const gendered = new Set([
                "Rogue", "Whisper", "Swordmaster", "Trueblade", "Halberdier", "Sentinel",
                "Priest", "Bishop", "Saint", "Armor Sword", "Sword General", "Dracoknight",
                "Dragonmaster", "Dragonlord", "Lance Knight", "Lance Paladin", "Axe Paladin",
                "Bow Paladin", "Thunder Mage", "Thunder Sage", "Fire Sage"
            ]);
            if (gendered.has(clsName)) {
                return isFemale ? `${clsName} (F)` : `${clsName} (M)`;
            }
            
            if (clsName === "Cat") return isFemale ? "Cat (F)" : "Cat (M)";
            if (clsName === "Raven") return isFemale ? "Raven (F)" : "Raven (M)";
            if (clsName === "Lion") {
                if (charName === "Skrimir") return "Lion (Skrimir)";
                if (charName === "Giffca") return "Lion (Giffca)";
                return "Lion King";
            }
            if (clsName === "Heron") {
                if (charName === "Rafiel") return "Heron (Rafiel)";
                if (charName === "Reyson") return "Heron (Reyson)";
                return "Heron (Leanne)";
            }
            if (clsName === "Red Dragon") return isFemale ? "Red Dragon (F)" : "Red Dragon (M)";
            
            return clsName;
        }

        function getFE10ClassType(clsName, isFemale) {
            const magical = new Set([
                "Light Sage", "Wind Sage", "Fire Sage", "Thunder Sage", "Dark Sage",
                "Bishop", "Cleric"
            ]);
            if (magical.has(clsName)) {
                return isFemale ? "Female Magical" : "Male Magical";
            }
            return isFemale ? "Female Physical" : "Male Physical";
        }

        function getFE10PromoGains(baseCls, promoCls, isFemale, promoGainsDb) {
            const suffix = isFemale ? "(female)" : "(male)";
            
            // 1. Try with suffix
            const keyGender = `${baseCls} ${suffix} -> ${promoCls} ${suffix}`;
            if (promoGainsDb[keyGender]) return promoGainsDb[keyGender];
            
            // 2. Try plain key
            const keyPlain = `${baseCls} -> ${promoCls}`;
            if (promoGainsDb[keyPlain]) return promoGainsDb[keyPlain];
            
            // 3. Fallback search
            for (const [key, gains] of Object.entries(promoGainsDb)) {
                if (key.includes(" -> ")) {
                    const parts = key.split(" -> ");
                    if (parts[0].includes(baseCls) && parts[1].includes(promoCls)) {
                        return gains;
                    }
                }
            }
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        function getFE10Caps(clsName, isFemale, capsDb, charName) {
            const capsKey = getFE10CapsKey(clsName, isFemale, charName);
            if (capsDb[capsKey]) return capsDb[capsKey];
            if (capsDb[clsName]) return capsDb[clsName];
            return Object.fromEntries(STATS.map(s => [s, 40]));
        }

        function calculateFE10AvgStatsJS(charName, targetClass) {
            const charData = FE10_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            const baseClass = charData.default_class;
            
            const capsDb = FE10_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE10_RAW_DATABASE.classes.promo_gains;
            
            let currentStats = {};
            for (const s of STATS) {
                currentStats[s] = Math.max(0, absBases[s]);
            }
            let history = [];
            
            // Laguz
            if (FE10_LAGUZ_CLASSES.has(baseClass)) {
                history.push([joinLv, baseClass, {...currentStats}]);
                const capsKey = getFE10CapsKey(baseClass, isFemale, charName);
                const clsCaps = capsDb[capsKey] || Object.fromEntries(STATS.map(s => [s, 40]));
                
                for (let lv = joinLv + 1; lv <= 40; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, baseClass, {...currentStats}]);
                }
                
                return {
                    classPath: baseClass,
                    finalClass: baseClass,
                    finalLevel: "40",
                    stats: currentStats,
                    history: history
                };
            }
            
            // Beorc multi-tier
            const charStartTier = getFE10ClassTier(baseClass);
            const targetTier = getFE10ClassTier(targetClass);
            
            const c1 = baseClass;
            const c2 = FE10_PROMOTION_MAP[c1] || null;
            const c3 = c2 ? (FE10_PROMOTION_MAP[c2] || null) : null;
            
            if (targetTier === 1) {
                history.push([joinLv, c1, {...currentStats}]);
                const c1CapsKey = getFE10CapsKey(c1, isFemale, charName);
                const c1Caps = capsDb[c1CapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growth = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growth / 100.0;
                        currentStats[s] = Math.min(c1Caps[s], currentStats[s]);
                    }
                    history.push([lv, c1, {...currentStats}]);
                }
                
                return {
                    classPath: c1,
                    finalClass: c1,
                    finalLevel: "20",
                    stats: currentStats,
                    history: history
                };
            }
            else if (targetTier === 2) {
                if (charStartTier === 1) {
                    // Level C1 to 20
                    history.push([joinLv, c1, {...currentStats}]);
                    const c1CapsKey = getFE10CapsKey(c1, isFemale, charName);
                    const c1Caps = capsDb[c1CapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c1Caps[s], currentStats[s]);
                        }
                        history.push([lv, c1, {...currentStats}]);
                    }
                    
                    // Promote C1 -> C2
                    const gains = getFE10PromoGains(c1, c2, isFemale, promoGainsDb);
                    const c2CapsKey = getFE10CapsKey(c2, isFemale, charName);
                    const c2Caps = capsDb[c2CapsKey] || Object.fromEntries(STATS.map(s => [s, 30]));
                    
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                    }
                    history.push(["20/1", c2, {...currentStats}]);
                    
                    // Level C2 from 2 to 20
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, c2, {...currentStats}]);
                    }
                    
                    return {
                        classPath: `${c1} ➔ ${c2}`,
                        finalClass: c2,
                        finalLevel: "20/20",
                        stats: currentStats,
                        history: history
                    };
                } else {
                    // Starts at Tier 2, level C2 from join_lv to 20
                    history.push([joinLv, c2, {...currentStats}]);
                    const c2CapsKey = getFE10CapsKey(c2, isFemale, charName);
                    const c2Caps = capsDb[c2CapsKey] || Object.fromEntries(STATS.map(s => [s, 30]));
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                        }
                        history.push([lv, c2, {...currentStats}]);
                    }
                    
                    return {
                        classPath: c2,
                        finalClass: c2,
                        finalLevel: "20",
                        stats: currentStats,
                        history: history
                    };
                }
            }
            else if (targetTier === 3) {
                if (charStartTier === 1) {
                    // 1. Level C1 to 20
                    history.push([joinLv, c1, {...currentStats}]);
                    const c1CapsKey = getFE10CapsKey(c1, isFemale, charName);
                    const c1Caps = capsDb[c1CapsKey] || Object.fromEntries(STATS.map(s => [s, 20]));
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c1Caps[s], currentStats[s]);
                        }
                        history.push([lv, c1, {...currentStats}]);
                    }
                    
                    // 2. Promote C1 -> C2
                    const gains12 = getFE10PromoGains(c1, c2, isFemale, promoGainsDb);
                    const c2CapsKey = getFE10CapsKey(c2, isFemale, charName);
                    const c2Caps = capsDb[c2CapsKey] || Object.fromEntries(STATS.map(s => [s, 30]));
                    
                    for (const s of STATS) {
                        currentStats[s] += gains12[s];
                        currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                    }
                    history.push(["20/1", c2, {...currentStats}]);
                    
                    // 3. Level C2 from 2 to 20
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, c2, {...currentStats}]);
                    }
                    
                    // 4. Promote C2 -> C3
                    const classType = getFE10ClassType(c2, isFemale);
                    const gains23 = promoGainsDb[classType] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const c3CapsKey = getFE10CapsKey(c3, isFemale, charName);
                    const c3Caps = capsDb[c3CapsKey] || Object.fromEntries(STATS.map(s => [s, 40]));
                    
                    for (const s of STATS) {
                        currentStats[s] += gains23[s];
                        currentStats[s] = Math.min(c3Caps[s], currentStats[s]);
                    }
                    history.push(["20/20/1", c3, {...currentStats}]);
                    
                    // 5. Level C3 from 2 to 20
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c3Caps[s], currentStats[s]);
                        }
                        history.push([`20/20/${lv}`, c3, {...currentStats}]);
                    }
                    
                    return {
                        classPath: `${c1} ➔ ${c2} ➔ ${c3}`,
                        finalClass: c3,
                        finalLevel: "20/20/20",
                        stats: currentStats,
                        history: history
                    };
                }
                else if (charStartTier === 2) {
                    // 1. Level C2 from join_lv to 20
                    history.push([joinLv, c2, {...currentStats}]);
                    const c2CapsKey = getFE10CapsKey(c2, isFemale, charName);
                    const c2Caps = capsDb[c2CapsKey] || Object.fromEntries(STATS.map(s => [s, 30]));
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c2Caps[s], currentStats[s]);
                        }
                        history.push([lv, c2, {...currentStats}]);
                    }
                    
                    // 2. Promote C2 -> C3
                    const classType = getFE10ClassType(c2, isFemale);
                    const gains23 = promoGainsDb[classType] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const c3CapsKey = getFE10CapsKey(c3, isFemale, charName);
                    const c3Caps = capsDb[c3CapsKey] || Object.fromEntries(STATS.map(s => [s, 40]));
                    
                    for (const s of STATS) {
                        currentStats[s] += gains23[s];
                        currentStats[s] = Math.min(c3Caps[s], currentStats[s]);
                    }
                    history.push(["20/1", c3, {...currentStats}]);
                    
                    // 3. Level C3 from 2 to 20
                    for (let lv = 2; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c3Caps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, c3, {...currentStats}]);
                    }
                    
                    return {
                        classPath: `${c2} ➔ ${c3}`,
                        finalClass: c3,
                        finalLevel: "20/20",
                        stats: currentStats,
                        history: history
                    };
                }
                else {
                    // Starts as Tier 3, level C3 from join_lv to 20
                    const c3 = targetClass;
                    history.push([joinLv, c3, {...currentStats}]);
                    const c3CapsKey = getFE10CapsKey(c3, isFemale, charName);
                    const c3Caps = capsDb[c3CapsKey] || Object.fromEntries(STATS.map(s => [s, 40]));
                    
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growth = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growth / 100.0;
                            currentStats[s] = Math.min(c3Caps[s], currentStats[s]);
                        }
                        history.push([lv, c3, {...currentStats}]);
                    }
                    
                    return {
                        classPath: c3,
                        finalClass: c3,
                        finalLevel: "20",
                        stats: currentStats,
                        history: history
                    };
                }
            }
            return null;
        }

        function calculateFE5AvgStatsJS(charName, targetClass) {
            const charData = FE5_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            const baseClass = charData.default_class;
            
            const promoGainsDb = FE5_RAW_DATABASE.classes.promo_gains;
            
            const STATS_FE5 = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Bld", "Mov"];
            const caps = { "HP": 80, "Str": 20, "Mag": 20, "Skl": 20, "Spd": 20, "Lck": 20, "Def": 20, "Bld": 20, "Mov": 20 };
            
            let currentStats = {};
            let history = [];
            
            for (const s of STATS_FE5) {
                currentStats[s] = Math.max(0, absBases[s]);
            }
            
            const FE5_PROMOTED_CLASSES = new Set([
                "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
            ]);
            
            function isFE5Promoted(cls) {
                return FE5_PROMOTED_CLASSES.has(cls);
            }
            
            if (isFE5Promoted(baseClass)) {
                history.push([joinLv, baseClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                    history.push([lv, baseClass, {...currentStats}]);
                }
                return {
                    classPath: baseClass,
                    finalClass: baseClass,
                    finalLevel: `${joinLv} ➔ 20`,
                    stats: currentStats,
                    history: history
                };
            }
            
            if (targetClass === baseClass) {
                history.push([joinLv, baseClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                    history.push([lv, baseClass, {...currentStats}]);
                }
                return {
                    classPath: baseClass,
                    finalClass: baseClass,
                    finalLevel: "20",
                    stats: currentStats,
                    history: history
                };
            }
            
            // Lara Dancer paths
            if (charName === "Lara" && targetClass === "Dancer") {
                history.push([joinLv, "Thief", {...currentStats}]);
                for (let lv = joinLv + 1; lv < 20; lv++) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                    history.push([lv, "Thief", {...currentStats}]);
                }
                
                // Reclass to Dancer
                const gainsKey = "Thief -> Dancer";
                const gains = promoGainsDb[gainsKey] || Object.fromEntries(STATS_FE5.map(s => [s, 0]));
                for (const s of STATS_FE5) {
                    currentStats[s] += gains[s];
                    currentStats[s] = Math.max(0.0, Math.min(caps[s], currentStats[s]));
                }
                history.push(["Promotion", "Dancer", {...currentStats}]);
                
                for (let lv = 1; lv <= 20; lv++) {
                    if (lv > 1) {
                        for (const s of STATS_FE5) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(caps[s], currentStats[s]);
                        }
                    }
                    history.push([`20/${lv}`, "Dancer", {...currentStats}]);
                }
                return {
                    classPath: "Thief ➔ Dancer",
                    finalClass: "Dancer",
                    finalLevel: "20/20",
                    stats: currentStats,
                    history: history
                };
            }
            
            if (charName === "Lara" && targetClass === "Thief Fighter (via Dancer)") {
                history.push([joinLv, "Thief", {...currentStats}]);
                for (let lv = joinLv + 1; lv < 20; lv++) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                    history.push([lv, "Thief", {...currentStats}]);
                }
                
                // Reclass to Dancer
                const gains1Key = "Thief -> Dancer";
                const gains1 = promoGainsDb[gains1Key] || Object.fromEntries(STATS_FE5.map(s => [s, 0]));
                for (const s of STATS_FE5) {
                    currentStats[s] += gains1[s];
                    currentStats[s] = Math.max(0.0, Math.min(caps[s], currentStats[s]));
                }
                history.push(["Promotion", "Dancer", {...currentStats}]);
                
                for (let lv = 2; lv <= 20; lv++) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                    history.push([`20/${lv}`, "Dancer", {...currentStats}]);
                }
                
                // Promote to Thief Fighter
                const gains2Key = "Dancer -> Thief Fighter";
                const gains2 = promoGainsDb[gains2Key] || Object.fromEntries(STATS_FE5.map(s => [s, 0]));
                for (const s of STATS_FE5) {
                    currentStats[s] += gains2[s];
                    currentStats[s] = Math.max(0.0, Math.min(caps[s], currentStats[s]));
                }
                history.push(["Promotion", "Thief Fighter", {...currentStats}]);
                
                for (let lv = 1; lv <= 20; lv++) {
                    if (lv > 1) {
                        for (const s of STATS_FE5) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(caps[s], currentStats[s]);
                        }
                    }
                    history.push([`20/20/${lv}`, "Thief Fighter", {...currentStats}]);
                }
                return {
                    classPath: "Thief ➔ Dancer ➔ Thief Fighter",
                    finalClass: "Thief Fighter",
                    finalLevel: "20/20/20",
                    stats: currentStats,
                    history: history
                };
            }
            
            // Standard single promotion
            history.push([joinLv, baseClass, {...currentStats}]);
            for (let lv = joinLv + 1; lv <= 20; lv++) {
                for (const s of STATS_FE5) {
                    const growthRate = Math.max(0, baseGrowths[s]);
                    currentStats[s] += growthRate / 100.0;
                    currentStats[s] = Math.min(caps[s], currentStats[s]);
                }
                history.push([lv, baseClass, {...currentStats}]);
            }
            
            const promoKey = `${baseClass} -> ${targetClass}`;
            const gains = promoGainsDb[promoKey] || Object.fromEntries(STATS_FE5.map(s => [s, 0]));
            for (const s of STATS_FE5) {
                currentStats[s] += gains[s];
                currentStats[s] = Math.min(caps[s], currentStats[s]);
            }
            history.push(["Promotion", targetClass, {...currentStats}]);
            
            for (let lv = 1; lv <= 20; lv++) {
                if (lv > 1) {
                    for (const s of STATS_FE5) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(caps[s], currentStats[s]);
                    }
                }
                history.push([`20/${lv}`, targetClass, {...currentStats}]);
            }
            
            return {
                classPath: `${baseClass} ➔ ${targetClass}`,
                finalClass: targetClass,
                finalLevel: "20/20",
                stats: currentStats,
                history: history
            };
        }

        function calculateFE11AvgStatsJS(charName, targetClass) {
            const charData = FE11_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const classBasesDb = FE11_RAW_DATABASE.classes.bases;
            const growthsDb = FE11_RAW_DATABASE.classes.growths;
            const capsDb = FE11_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE11_RAW_DATABASE.classes.promo_gains;
            
            const FE11_BASE_CLASSES = new Set([
                "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
            ]);
            const FE11_PROMOTED_CLASSES = new Set([
                "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
            ]);
            const FE11_SPECIAL_CLASSES = new Set([
                "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
            ]);
            
            const FE11_CLASS_TO_GROWTH_GROUP = {
                "Lord": "Lord", "Pegasus Knight": "Pegasus Knight", "Falcon Knight": "Falcon Knight",
                "Dracoknight": "Dracoknight (M)", "Cavalier": "Cavalier / Paladin", "Paladin": "Cavalier / Paladin",
                "Knight": "Knight / General", "General": "Knight / General",
                "Archer": "Archer / Sniper", "Sniper": "Archer / Sniper",
                "Mercenary": "Mercenary / Hero", "Hero": "Mercenary / Hero",
                "Myrmidon": "Myrmidon / Swordmaster", "Swordmaster": "Myrmidon / Swordmaster",
                "Fighter": "Fighter / Warrior", "Warrior": "Fighter / Warrior",
                "Hunter": "Hunter / Horseman", "Horseman": "Hunter / Horseman",
                "Pirate": "Pirate / Berserker", "Berserker": "Pirate / Berserker",
                "Dark Mage": "Dark Mage / Sorcerer", "Sorcerer": "Dark Mage / Sorcerer",
                "Mage": "Mage", "Sage": "Sage",
                "Curate": "Curate / Cleric", "Cleric": "Curate / Cleric", "Bishop": "Bishop",
                "Thief": "Thief", "Manakete": "Manakete", "Ballistician": "Ballistician", "Chameleon": "Chameleon"
            };

            const FE11_PROMOTION_MAP = {
                "Falcon Knight": "Pegasus Knight", "Dracoknight": "Pegasus Knight",
                "Paladin": "Cavalier", "Sniper": "Archer", "Swordmaster": "Myrmidon",
                "Sage": "Mage", "Bishop": "Curate", "General": "Knight", "Hero": "Mercenary",
                "Warrior": "Fighter", "Horseman": "Hunter", "Berserker": "Pirate", "Sorcerer": "Dark Mage"
            };

            function getFE11BaseClass(promoCls, isFem) {
                if (promoCls === "Dracoknight") return isFem ? "Pegasus Knight" : "Cavalier";
                if (promoCls === "Bishop") return isFem ? "Cleric" : "Curate";
                return FE11_PROMOTION_MAP[promoCls] || null;
            }

            function getFE11Caps(clsName) {
                if (capsDb[clsName]) return capsDb[clsName];
                if (FE11_BASE_CLASSES.has(clsName) || !FE11_PROMOTED_CLASSES.has(clsName)) {
                    return capsDb["Non-promoted"] || Object.fromEntries(STATS.map(s => [s, 20]));
                }
                return Object.fromEntries(STATS.map(s => [s, 20]));
            }

            function getFE11ClassGrowths(clsName) {
                let group = FE11_CLASS_TO_GROWTH_GROUP[clsName];
                if (clsName === "Dracoknight" && isFemale) {
                    group = "Dracoknight (F)";
                }
                if (group && growthsDb[group]) return growthsDb[group];
                return Object.fromEntries(STATS.map(s => [s, 0]));
            }

            function getFE11PromoGains(baseCls, promoCls) {
                const key = `${baseCls} -> ${promoCls}`;
                if (promoGainsDb[key]) return promoGainsDb[key];
                const baseClassBases = classBasesDb[baseCls] || Object.fromEntries(STATS.map(s => [s, 0]));
                const promoClassBases = classBasesDb[promoCls] || Object.fromEntries(STATS.map(s => [s, 0]));
                const gains = {};
                for (const s of STATS) {
                    gains[s] = promoClassBases[s] - baseClassBases[s];
                }
                return gains;
            }

            let currentStats = {};
            let history = [];
            
            if (FE11_SPECIAL_CLASSES.has(targetClass)) {
                const clsBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                const clsCaps = getFE11Caps(targetClass);
                const clsGrowths = getFE11ClassGrowths(targetClass);
                for (const s of STATS) {
                    currentStats[s] = Math.min(clsCaps[s], Math.max(0, absBases[s] + clsBases[s]));
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 30; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s] + clsGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "30", stats: currentStats, history: history };
            }
            else if (FE11_PROMOTED_CLASSES.has(targetClass)) {
                let baseCls = getFE11BaseClass(targetClass, isFemale);
                if (!baseCls) baseCls = "Cavalier";
                const isAlreadyPromoted = FE11_PROMOTED_CLASSES.has(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const baseBases = classBasesDb[baseCls] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const baseCaps = getFE11Caps(baseCls);
                    const baseGrowthsCls = getFE11ClassGrowths(baseCls);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(baseCaps[s], Math.max(0, absBases[s] + baseBases[s]));
                    }
                    history.push([joinLv, baseCls, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + baseGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                        }
                        history.push([lv, baseCls, {...currentStats}]);
                    }
                    const gains = getFE11PromoGains(baseCls, targetClass);
                    const promoCaps = getFE11Caps(targetClass);
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push(["Promotion", targetClass, {...currentStats}]);
                    const promoGrowthsCls = getFE11ClassGrowths(targetClass);
                    for (let lv = 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + promoGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, targetClass, {...currentStats}]);
                    }
                    return { classPath: `${baseCls} ➔ ${targetClass}`, finalClass: targetClass, finalLevel: "20/20", stats: currentStats, history: history };
                } else {
                    const promoBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const promoCaps = getFE11Caps(targetClass);
                    const promoGrowthsCls = getFE11ClassGrowths(targetClass);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(promoCaps[s], Math.max(0, absBases[s] + promoBases[s]));
                    }
                    history.push([joinLv, targetClass, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + promoGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, targetClass, {...currentStats}]);
                    }
                    return { classPath: targetClass, finalClass: targetClass, finalLevel: `${joinLv} ➔ 20`, stats: currentStats, history: history };
                }
            }
            else {
                const baseBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                const baseCaps = getFE11Caps(targetClass);
                const baseGrowthsCls = getFE11ClassGrowths(targetClass);
                for (const s of STATS) {
                    currentStats[s] = Math.min(baseCaps[s], Math.max(0, absBases[s] + baseBases[s]));
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s] + baseGrowthsCls[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
        }

        function getBaseClass(promotedClass, isFemale) {
            if (promotedClass === "Dracoknight") return isFemale ? "Pegasus Knight" : "Cavalier";
            if (promotedClass === "Bishop") return isFemale ? "Cleric" : "Curate";
            return PROMOTION_MAP[promotedClass] || null;
        }

        function getCapsForClass(clsName, capsDb) {
            if (currentGame === "fe5") {
                return { "HP": 80, "Str": 20, "Mag": 20, "Skl": 20, "Spd": 20, "Lck": 20, "Def": 20, "Bld": 20, "Mov": 20 };
            }
            if (currentGame === "fe8") {
                return getFE8Caps(clsName, activeRawDb.characters[currentCharacterName].is_female, capsDb);
            }
            if (currentGame === "fe7") {
                return getFE7Caps(clsName, activeRawDb.characters[currentCharacterName].is_female, capsDb);
            }
            if (currentGame === "fe6") {
                return getFE6Caps(clsName, activeRawDb.characters[currentCharacterName].is_female, capsDb);
            }
            if (currentGame === "fe9") {
                return getFE9Caps(clsName, activeRawDb.characters[currentCharacterName].is_female, capsDb, currentCharacterName);
            }
            if (currentGame === "fe10") {
                return getFE10Caps(clsName, activeRawDb.characters[currentCharacterName].is_female, capsDb, currentCharacterName);
            }
            if (capsDb[clsName]) return capsDb[clsName];
            if (BASE_CLASSES.has(clsName) || !PROMOTED_CLASSES.has(clsName)) {
                return capsDb["Non-promoted"] || Object.fromEntries(STATS.map(s => [s, 20]));
            }
            return Object.fromEntries(STATS.map(s => [s, 20]));
        }

        function getClassGrowths(clsName, growthsDb) {
            const group = CLASS_TO_GROWTH_GROUP[clsName];
            if (group && growthsDb[group]) return growthsDb[group];
            return Object.fromEntries(STATS.map(s => [s, 0]));
        }

        function getPromoGains(baseCls, promoCls, promoGainsDb, classBasesDb) {
            const key = `${baseCls} -> ${promoCls}`;
            if (promoGainsDb[key]) return promoGainsDb[key];
            const baseClassBases = classBasesDb[baseCls] || Object.fromEntries(STATS.map(s => [s, 0]));
            const promoClassBases = classBasesDb[promoCls] || Object.fromEntries(STATS.map(s => [s, 0]));
            const gains = {};
            for (const s of STATS) {
                gains[s] = promoClassBases[s] - baseClassBases[s];
            }
            return gains;
        }

        function calculateFE6AvgStatsJS(charName, targetClass) {
            const charData = FE6_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const capsDb = FE6_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE6_RAW_DATABASE.classes.promo_gains;
            
            let currentStats = {};
            let history = [];
            
            if (FE6_SPECIAL_CLASSES.has(targetClass)) {
                const clsCaps = getFE6Caps(targetClass, isFemale, capsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.max(0, absBases[s]);
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
            else if (isFE6Promoted(targetClass)) {
                const isAlreadyPromoted = isFE6Promoted(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const baseCls = charData.default_class;
                    const baseCaps = getFE6Caps(baseCls, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, baseCls, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                        }
                        history.push([lv, baseCls, {...currentStats}]);
                    }
                    
                    const gains = getFE6PromoGains(baseCls, targetClass, isFemale, promoGainsDb);
                    const promoCaps = getFE6Caps(targetClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push(["Promotion", targetClass, {...currentStats}]);
                    
                    for (let lv = 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, targetClass, {...currentStats}]);
                    }
                    return { classPath: `${baseCls} ➔ ${targetClass}`, finalClass: targetClass, finalLevel: "20/20", stats: currentStats, history: history };
                } else {
                    const promoCaps = getFE6Caps(targetClass, isFemale, capsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.max(0, absBases[s]);
                    }
                    history.push([joinLv, targetClass, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, targetClass, {...currentStats}]);
                    }
                    return { classPath: targetClass, finalClass: targetClass, finalLevel: `${joinLv} ➔ 20`, stats: currentStats, history: history };
                }
            }
            else {
                const baseCaps = getFE6Caps(targetClass, isFemale, capsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.max(0, absBases[s]);
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
        }

        function calculateAvgStatsJS(charName, targetClass) {
            if (currentGame === "fe5") {
                return calculateFE5AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe11") {
                return calculateFE11AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe8") {
                return calculateFE8AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe6") {
                return calculateFE6AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe7") {
                return calculateFE7AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe9") {
                return calculateFE9AvgStatsJS(charName, targetClass);
            }
            if (currentGame === "fe10") {
                return calculateFE10AvgStatsJS(charName, targetClass);
            }
            const charData = FE12_RAW_DATABASE.characters[charName];
            const isFemale = charData.is_female;
            const joinLv = charData.join_lv;
            const absBases = charData.absolute_bases;
            const baseGrowths = charData.base_growths;
            
            const classBasesDb = FE12_RAW_DATABASE.classes.bases;
            const growthsDb = FE12_RAW_DATABASE.classes.growths;
            const capsDb = FE12_RAW_DATABASE.classes.caps;
            const promoGainsDb = FE12_RAW_DATABASE.classes.promo_gains;
            
            let currentStats = {};
            let history = [];
            
            if (SPECIAL_CLASSES.has(targetClass)) {
                const clsBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                const clsCaps = getCapsForClass(targetClass, capsDb);
                const clsGrowths = getClassGrowths(targetClass, growthsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.min(clsCaps[s], Math.max(0, absBases[s] + clsBases[s]));
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 30; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s] + clsGrowths[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(clsCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "30", stats: currentStats, history: history };
            }
            else if (PROMOTED_CLASSES.has(targetClass)) {
                let baseCls = getBaseClass(targetClass, isFemale);
                if (!baseCls) baseCls = "Cavalier";
                const isAlreadyPromoted = PROMOTED_CLASSES.has(charData.default_class);
                
                if (!isAlreadyPromoted) {
                    const baseBases = classBasesDb[baseCls] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const baseCaps = getCapsForClass(baseCls, capsDb);
                    const baseGrowthsCls = getClassGrowths(baseCls, growthsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(baseCaps[s], Math.max(0, absBases[s] + baseBases[s]));
                    }
                    history.push([joinLv, baseCls, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + baseGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                        }
                        history.push([lv, baseCls, {...currentStats}]);
                    }
                    const gains = getPromoGains(baseCls, targetClass, promoGainsDb, classBasesDb);
                    const promoCaps = getCapsForClass(targetClass, capsDb);
                    for (const s of STATS) {
                        currentStats[s] += gains[s];
                        currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                    }
                    history.push(["Promotion", targetClass, {...currentStats}]);
                    const promoGrowthsCls = getClassGrowths(targetClass, growthsDb);
                    for (let lv = 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + promoGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([`20/${lv}`, targetClass, {...currentStats}]);
                    }
                    return { classPath: `${baseCls} ➔ ${targetClass}`, finalClass: targetClass, finalLevel: "20/20", stats: currentStats, history: history };
                } else {
                    const promoBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                    const promoCaps = getCapsForClass(targetClass, capsDb);
                    const promoGrowthsCls = getClassGrowths(targetClass, growthsDb);
                    for (const s of STATS) {
                        currentStats[s] = Math.min(promoCaps[s], Math.max(0, absBases[s] + promoBases[s]));
                    }
                    history.push([joinLv, targetClass, {...currentStats}]);
                    for (let lv = joinLv + 1; lv <= 20; lv++) {
                        for (const s of STATS) {
                            const growthRate = Math.max(0, baseGrowths[s] + promoGrowthsCls[s]);
                            currentStats[s] += growthRate / 100.0;
                            currentStats[s] = Math.min(promoCaps[s], currentStats[s]);
                        }
                        history.push([lv, targetClass, {...currentStats}]);
                    }
                    return { classPath: targetClass, finalClass: targetClass, finalLevel: `${joinLv} ➔ 20`, stats: currentStats, history: history };
                }
            }
            else {
                const baseBases = classBasesDb[targetClass] || Object.fromEntries(STATS.map(s => [s, 0]));
                const baseCaps = getCapsForClass(targetClass, capsDb);
                const baseGrowthsCls = getClassGrowths(targetClass, growthsDb);
                for (const s of STATS) {
                    currentStats[s] = Math.min(baseCaps[s], Math.max(0, absBases[s] + baseBases[s]));
                }
                history.push([joinLv, targetClass, {...currentStats}]);
                for (let lv = joinLv + 1; lv <= 20; lv++) {
                    for (const s of STATS) {
                        const growthRate = Math.max(0, baseGrowths[s] + baseGrowthsCls[s]);
                        currentStats[s] += growthRate / 100.0;
                        currentStats[s] = Math.min(baseCaps[s], currentStats[s]);
                    }
                    history.push([lv, targetClass, {...currentStats}]);
                }
                return { classPath: targetClass, finalClass: targetClass, finalLevel: "20", stats: currentStats, history: history };
            }
        }

        // --- State Variables ---
        let currentCharacterName = "Shiida";
        let activeTabId = "reclass-list-view";
        let checkedChartStats = { "HP": true, "Str": true, "Mag": false, "Skl": true, "Spd": true, "Lck": true, "Def": true, "Res": false };
        let selectedSimClass = "";
        let selectedBstClass = "";
        let bstClassRankings = {};
        
        // Sorting State for Reclass Statistics Table
        let currentSortColumn = "class";
        let currentSortOrder = "asc";

        // --- BST Leaderboard Systems ---
        function getDirectPromotionClass(charName) {
            const charData = activeRawDb.characters[charName];
            const defaultClass = charData.default_class;
            
            if (currentGame === "fe5") {
                if (charName === "Machua") return "Mercenary";
                if (charName === "Miranda") return "Mage Knight";
                const mapping = {
                    "Lord": "Prince",
                    "Social Knight": "Paladin",
                    "Troubadour": "Paladin",
                    "Free Knight": "Forrest Knight",
                    "Lance Knight": "Duke Knight",
                    "Axe Knight": "Great Knight",
                    "Axe Armour": "General",
                    "Axe Fighter": "Mercenary",
                    "Swordfighter": "Swordmaster",
                    "Bow Fighter": "Sniper",
                    "Arch Knight": "Bow Knight",
                    "Mountain Thief": "Warrior",
                    "Pegasus Rider": "Pegasus Knight",
                    "Dragon Rider": "Dragon Knight",
                    "Priest": "High Priest",
                    "Sister": "Sage",
                    "Bard": "Sage",
                    "Mage": "Sage",
                    "Loputo Mage": "Dark Mage",
                    "Thief": "Thief Fighter"
                };
                const promoted = mapping[defaultClass];
                if (promoted) return promoted;
                return defaultClass;
            }
            
            if (currentGame === "fe10") {
                if (FE10_LAGUZ_CLASSES.has(defaultClass)) {
                    return defaultClass;
                }
                const promoted = FE10_PROMOTION_MAP[defaultClass];
                if (!promoted) return defaultClass;
                
                // If starting class is Tier 1, go directly to Tier 3 for direct promo comparison!
                if (getFE10ClassTier(defaultClass) === 1) {
                    const tier2 = promoted;
                    const tier3 = FE10_PROMOTION_MAP[tier2] || tier2;
                    return tier3;
                }
                return promoted;
            }
            
            if (currentGame === "fe9") {
                if (charName === "Volke") {
                    return "Assassin";
                }
                if (FE9_SPECIAL_CLASSES.has(defaultClass)) {
                    return defaultClass;
                }
                const promoted = FE9_PROMOTION_MAP[defaultClass];
                if (promoted) return promoted;
                return defaultClass;
            }
            
            if (currentGame === "fe8") {
                const isFemale = charData.is_female;
                const genderSuffix = isFemale ? " (F)" : " (M)";
                
                if (isFE8Promoted(defaultClass) || defaultClass === "Manakete" || defaultClass === "Dancer") {
                    return defaultClass;
                }
                
                // Trainees
                if (charName === "Ross") return "Warrior (via Fighter)";
                if (charName === "Amelia") return "General (F) (via Knight (F))";
                if (charName === "Ewan") return "Sage (M) (via Mage (M))";
                
                // Lords
                if (defaultClass === "Lord") {
                    if (charName.includes("Eirika")) return "Great Lord (Eirika)";
                    return "Great Lord (Ephraim)";
                }
                
                const mapping = {
                    "Cavalier": "Paladin",
                    "Knight": "General",
                    "Thief": "Rogue",
                    "Mercenary": "Hero",
                    "Myrmidon": "Swordmaster",
                    "Archer": "Sniper",
                    "Wyvern Rider": "Wyvern Lord",
                    "Pegasus Knight": "Falcoknight",
                    "Mage": "Sage",
                    "Shaman": "Druid",
                    "Priest": "Bishop",
                    "Monk": "Bishop",
                    "Cleric": "Bishop",
                    "Troubadour": "Valkyrie",
                    "Fighter": "Warrior",
                    "Pirate": "Berserker"
                };
                
                const promo = mapping[defaultClass];
                if (!promo) return defaultClass;
                
                if (["Paladin", "General", "Hero", "Swordmaster", "Sniper", "Wyvern Lord", "Sage", "Druid", "Bishop"].includes(promo)) {
                    return `${promo}${genderSuffix}`;
                }
                return promo;
            }
            
            if (currentGame === "fe7") {
                if (FE7_SPECIAL_CLASSES.has(defaultClass) || isFE7Promoted(defaultClass)) {
                    return defaultClass;
                }
                if (defaultClass === "Lord") {
                    if (charName.includes("Lyn")) return "Blade Lord";
                    if (charName.includes("Eliwood")) return "Knight Lord";
                    if (charName.includes("Hector")) return "Great Lord";
                }
                const promoted = FE7_PROMOTION_MAP[defaultClass];
                if (promoted) return promoted;
                return defaultClass;
            }
            
            if (currentGame === "fe6") {
                if (FE6_SPECIAL_CLASSES.has(defaultClass) || isFE6Promoted(defaultClass)) {
                    return defaultClass;
                }
                const promoted = FE6_PROMOTION_MAP[defaultClass];
                if (promoted) return promoted;
                if (defaultClass === "Bandit" || defaultClass === "Brigand" || defaultClass === "Pirate") {
                    return "Berserker";
                }
                if (defaultClass === "Cleric" || defaultClass === "Priest") {
                    return "Bishop";
                }
                return defaultClass;
            } else if (currentGame === "fe11") {
                const FE11_PROMOTED_CLASSES = new Set([
                    "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                    "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
                ]);
                const FE11_SPECIAL_CLASSES = new Set([
                    "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                ]);
                const FE11_PROMOTION_MAP = {
                    "Falcon Knight": "Pegasus Knight", "Dracoknight": "Pegasus Knight",
                    "Paladin": "Cavalier", "Sniper": "Archer", "Swordmaster": "Myrmidon",
                    "Sage": "Mage", "Bishop": "Curate", "General": "Knight", "Hero": "Mercenary",
                    "Warrior": "Fighter", "Horseman": "Hunter", "Berserker": "Pirate", "Sorcerer": "Dark Mage"
                };

                if (FE11_PROMOTED_CLASSES.has(defaultClass) || FE11_SPECIAL_CLASSES.has(defaultClass)) {
                    return defaultClass;
                }
                
                if (defaultClass === "Pegasus Knight") {
                    return "Falcon Knight"; // Elysian Whip override
                }
                
                for (const [promoted, base] of Object.entries(FE11_PROMOTION_MAP)) {
                    if (base === defaultClass) {
                        if (defaultClass === "Cavalier" && promoted === "Dracoknight") continue;
                        return promoted;
                    }
                }
                
                if (defaultClass === "Cleric" || defaultClass === "Curate") return "Bishop";
                
                return defaultClass;
            } else {
                if (PROMOTED_CLASSES.has(defaultClass) || SPECIAL_CLASSES.has(defaultClass)) {
                    return defaultClass;
                }
                
                // Base class promotion mapping
                if (defaultClass === "Pegasus Knight") {
                    return "Falcon Knight"; // Elysian Whip override
                }
                
                // Find in PROMOTION_MAP
                for (const [promoted, base] of Object.entries(PROMOTION_MAP)) {
                    if (base === defaultClass) {
                        if (defaultClass === "Cavalier" && promoted === "Dracoknight") continue;
                        return promoted;
                    }
                }
                
                if (defaultClass === "Cleric" || defaultClass === "Curate") return "Bishop";
                
                return defaultClass;
            }
        }

        function computeBSTRankings() {
            bstClassRankings = {};
            
            Object.keys(activeStatsData).forEach(charName => {
                const charData = activeStatsData[charName];
                
                if (charName.includes("My Unit")) {
                    const PROMOTED_OR_SPECIAL_CLASSES = new Set([
                        "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                        "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer",
                        "Lord", "Thief", "Dancer", "Chameleon", "Manakete", "Ballistician"
                    ]);
                    Object.keys(charData.classes).forEach(clsName => {
                        if (PROMOTED_OR_SPECIAL_CLASSES.has(clsName)) {
                            const classData = charData.classes[clsName];
                            if (classData) {
                                let bst = 0;
                                STATS.forEach(s => {
                                    bst += classData.stats[s];
                                });
                                
                                if (!bstClassRankings[clsName]) {
                                    bstClassRankings[clsName] = [];
                                }
                                bstClassRankings[clsName].push({
                                    name: charName,
                                    classPath: classData.class_path,
                                    finalLevel: classData.final_level,
                                    stats: classData.stats,
                                    bst: bst
                                });
                            }
                        }
                    });
                } else {
                    const directClass = getDirectPromotionClass(charName);
                    if (directClass) {
                        if (!bstClassRankings[directClass]) {
                            bstClassRankings[directClass] = [];
                        }
                        
                        const classData = charData.classes[directClass];
                        if (classData) {
                            let bst = 0;
                            STATS.forEach(s => {
                                bst += classData.stats[s];
                            });
                            
                            bstClassRankings[directClass].push({
                                name: charName,
                                classPath: classData.class_path,
                                finalLevel: classData.final_level,
                                stats: classData.stats,
                                bst: bst
                            });
                        }
                    }
                }
            });
            
            Object.keys(bstClassRankings).forEach(className => {
                bstClassRankings[className].sort((a, b) => b.bst - a.bst);
            });
        }

        function initBSTLeaderboard() {
            const gridContainer = document.getElementById("bst-class-grid-container");
            gridContainer.innerHTML = "";
            
            const sortedClasses = Object.keys(bstClassRankings).sort();
            
            if (!selectedBstClass || !sortedClasses.includes(selectedBstClass)) {
                selectedBstClass = sortedClasses.includes("Falcon Knight") ? "Falcon Knight" : (sortedClasses.includes("Falcoknight") ? "Falcoknight" : sortedClasses[0]);
            }
            
            sortedClasses.forEach(className => {
                const list = bstClassRankings[className];
                const leader = list[0];
                const card = document.createElement("div");
                card.className = `bst-class-card ${className === selectedBstClass ? 'active' : ''}`;
                card.id = `bst-cls-card-${className.replace(/\s+/g, '_')}`;
                card.onclick = () => selectBstClass(className);
                
                card.innerHTML = `
                    <div style="display:flex; flex-direction:column; gap:2px;">
                        <span style="font-weight:600; font-size:0.9rem;">${className}</span>
                        <span style="font-size:0.7rem; opacity:0.6;">${list.length} units</span>
                    </div>
                    <div class="bst-class-card-leader">
                        <span style="font-size:0.8rem; font-weight:700;">${leader.name}</span>
                        <span style="font-size:0.7rem; opacity:0.8; font-weight:600;">(${leader.bst.toFixed(1)})</span>
                    </div>
                `;
                
                gridContainer.appendChild(card);
            });
            
            renderBSTLeaderboard(selectedBstClass);
        }

        function selectBstClass(className) {
            selectedBstClass = className;
            document.querySelectorAll(".bst-class-card").forEach(item => item.classList.remove("active"));
            const card = document.getElementById(`bst-cls-card-${className.replace(/\s+/g, '_')}`);
            if (card) card.classList.add("active");
            renderBSTLeaderboard(className);
        }

        function renderBSTLeaderboard(className) {
            const list = bstClassRankings[className];
            if (!list || list.length === 0) return;
            
            const titleEl = document.getElementById("bst-class-title");
            const maxLvEl = document.getElementById("bst-class-max-lv");
            const descEl = document.getElementById("bst-class-desc");
            const listContainer = document.getElementById("bst-leaderboard-list-container");
            
            titleEl.innerText = `${className} Leaderboard`;
            maxLvEl.innerText = `Max Lv: ${list[0].finalLevel}`;
            
            let badgeClass = 'promo';
            if (currentGame === "fe5") {
                const FE5_PROMOTED_CLASSES = new Set([
                    "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                    "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                    "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                    "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                ]);
                if (className === "Dancer") badgeClass = 'special';
                else if (!FE5_PROMOTED_CLASSES.has(className)) badgeClass = '';
            } else if (currentGame === "fe10") {
                if (FE10_LAGUZ_CLASSES.has(className)) badgeClass = 'special';
                else if (getFE10ClassTier(className) === 1) badgeClass = '';
            } else if (currentGame === "fe8") {
                if (FE8_SPECIAL_CLASSES.has(className)) badgeClass = 'special';
                else if (!isFE8Promoted(className)) badgeClass = '';
            } else if (currentGame === "fe7") {
                if (FE7_SPECIAL_CLASSES.has(className)) badgeClass = 'special';
                else if (!isFE7Promoted(className)) badgeClass = '';
            } else if (currentGame === "fe6") {
                if (FE6_SPECIAL_CLASSES.has(className)) badgeClass = 'special';
                else if (!isFE6Promoted(className)) badgeClass = '';
            } else if (currentGame === "fe9") {
                if (FE9_SPECIAL_CLASSES.has(className)) badgeClass = 'special';
                else if (!isFE9Promoted(className)) badgeClass = '';
            } else {
                if (SPECIAL_CLASSES.has(className)) badgeClass = 'special';
                else if (BASE_CLASSES.has(className)) badgeClass = '';
            }
            maxLvEl.className = `max-lv-badge ${badgeClass}`;
            
            descEl.innerText = `Playable characters who stick to their default classes and promote directly to ${className}, ranked by their final max-level BST.`;
            
            listContainer.innerHTML = "";
            const capsDb = activeRawDb.classes.caps;
            const classCaps = getCapsForClass(className, capsDb);
            
            list.forEach((item, index) => {
                const rank = index + 1;
                const isLeader = rank === 1;
                const row = document.createElement("div");
                row.className = `bst-rank-item ${isLeader ? 'leader' : ''}`;
                
                let statsHTML = "";
                STATS.forEach(s => {
                    const val = item.stats[s];
                    const cap = classCaps[s];
                    const isCapped = val >= cap;
                    statsHTML += `
                        <div class="bst-rank-stat-box">
                            <span class="bst-rank-stat-name">${s}</span>
                            <span class="bst-rank-stat-val ${isCapped ? 'capped' : ''}">
                                ${val.toFixed(1)}
                                ${isCapped ? '★' : ''}
                            </span>
                        </div>
                    `;
                });
                
                row.innerHTML = `
                    <div class="bst-rank-badge">
                        ${isLeader ? '👑' : rank}
                    </div>
                    <div class="bst-rank-name-col" onclick="loadCharacterDetails('${item.name}')">
                        ${item.name}
                        ${isLeader ? ' <span style="font-size:0.75rem; color:#fbbf24;">★</span>' : ''}
                    </div>
                    <div class="bst-rank-bst-col">
                        <span class="bst-rank-bst-val">${item.bst.toFixed(1)}</span>
                        <span class="bst-rank-bst-label">BST Total</span>
                    </div>
                    <div class="bst-rank-stats-grid">
                        ${statsHTML}
                    </div>
                `;
                
                listContainer.appendChild(row);
            });
        }

        function renderTableHeaders() {
            const tableHeaders = document.getElementById("table-headers");
            if (!tableHeaders) return;
            
            let html = `
                <th onclick="handleHeaderClick('class')">Class Path <span id="sort-icon-class"></span></th>
                <th onclick="handleHeaderClick('level')">Max Level <span id="sort-icon-level"></span></th>
                <th onclick="handleHeaderClick('bst')">BST <span id="sort-icon-bst"></span></th>
            `;
            
            STATS.forEach(s => {
                html += `<th onclick="handleHeaderClick('${s}')">${s} <span id="sort-icon-${s}"></span></th>`;
            });
            
            tableHeaders.innerHTML = html;
        }

        function renderSimTableHeaders() {
            const tr = document.querySelector("#simulator-view table thead tr");
            if (!tr) return;
            
            let html = `
                <th>Level</th>
                <th>Class</th>
            `;
            STATS.forEach(s => {
                html += `<th>${s}</th>`;
            });
            tr.innerHTML = html;
        }

        function renderChartCheckboxes() {
            const container = document.getElementById("chart-checkboxes-container");
            if (!container) return;
            
            let html = `<div class="chart-control-title">Toggle Chart Statistics</div>`;
            STATS.forEach(s => {
                const color = STAT_COLORS[s] || `var(--stat-${s.toLowerCase()})`;
                const isChecked = checkedChartStats[s] ? "checked" : "";
                const activeClass = checkedChartStats[s] ? "checked" : "";
                html += `
                    <label class="stat-checkbox-label ${activeClass}" id="lbl-chk-${s}">
                        <span class="stat-dot" style="background-color: ${color}"></span>
                        <input type="checkbox" class="stat-checkbox" id="chk-${s}" ${isChecked} onchange="toggleChartStat('${s}')">
                        <span>${s}</span>
                    </label>
                `;
            });
            container.innerHTML = html;
        }

        // --- Switch Games ---
        function switchGame(gameId) {
            currentGame = gameId;
            activeStatsData = AVERAGE_STATS_DATA[currentGame];
            
            // Keep the select dropdown value in sync with currentGame
            const selector = document.getElementById("game-selector");
            if (selector && selector.value !== gameId) {
                selector.value = gameId;
            }
            
            // Set dynamic STATS list and checkedChartStats based on game selection
            if (currentGame === "fe5") {
                STATS = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Bld", "Mov"];
                checkedChartStats = { "HP": true, "Str": true, "Mag": false, "Skl": true, "Spd": true, "Lck": false, "Def": true, "Bld": false, "Mov": false };
            } else {
                STATS = ["HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Res"];
                checkedChartStats = { "HP": true, "Str": true, "Mag": false, "Skl": true, "Spd": true, "Lck": true, "Def": true, "Res": false };
            }
            
            if (currentGame === "fe12") {
                activeRawDb = FE12_RAW_DATABASE;
            } else if (currentGame === "fe11") {
                activeRawDb = FE11_RAW_DATABASE;
            } else if (currentGame === "fe6") {
                activeRawDb = FE6_RAW_DATABASE;
            } else if (currentGame === "fe7") {
                activeRawDb = FE7_RAW_DATABASE;
            } else if (currentGame === "fe8") {
                activeRawDb = FE8_RAW_DATABASE;
            } else if (currentGame === "fe9") {
                activeRawDb = FE9_RAW_DATABASE;
            } else if (currentGame === "fe10") {
                activeRawDb = FE10_RAW_DATABASE;
            } else if (currentGame === "fe5") {
                activeRawDb = FE5_RAW_DATABASE;
            }
            
            // Clear search and filters
            document.getElementById("search-bar").value = "";
            document.getElementById("filter-gender").value = "all";
            document.getElementById("filter-pool").value = "all";
            const tableFilter = document.getElementById("filter-table-tier");
            if (tableFilter) {
                tableFilter.value = "all";
            }
            
            // Theme colors transition
            const root = document.documentElement;
            if (currentGame === "fe5") {
                root.style.setProperty('--accent-primary', '#10b981'); // Moss Green
                root.style.setProperty('--accent-secondary', '#f59e0b'); // Forest Gold
                root.style.setProperty('--accent-glow', 'rgba(16, 185, 129, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.25) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe8") {
                root.style.setProperty('--accent-primary', '#8b5cf6');
                root.style.setProperty('--accent-secondary', '#d946ef');
                root.style.setProperty('--accent-glow', 'rgba(139, 92, 246, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(139, 92, 246, 0.2) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe7") {
                root.style.setProperty('--accent-primary', '#10b981');
                root.style.setProperty('--accent-secondary', '#06b6d4');
                root.style.setProperty('--accent-glow', 'rgba(16, 185, 129, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(16, 80, 60, 0.2) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe6") {
                root.style.setProperty('--accent-primary', '#f59e0b');
                root.style.setProperty('--accent-secondary', '#ef4444');
                root.style.setProperty('--accent-glow', 'rgba(245, 158, 11, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.15) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe9") {
                root.style.setProperty('--accent-primary', '#10b981'); // Crimea Emerald
                root.style.setProperty('--accent-secondary', '#fbbf24'); // Gold
                root.style.setProperty('--accent-glow', 'rgba(16, 185, 129, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.2) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe10") {
                root.style.setProperty('--accent-primary', '#f97316'); // Dawn Orange
                root.style.setProperty('--accent-secondary', '#fbbf24'); // Radiant Gold
                root.style.setProperty('--accent-glow', 'rgba(249, 115, 22, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.2) 0%, rgba(11, 15, 25, 0) 70%)';
            } else if (currentGame === "fe11") {
                root.style.setProperty('--accent-primary', '#06b6d4'); // Cyan Dragonfire
                root.style.setProperty('--accent-secondary', '#3b82f6'); // Royal Blue
                root.style.setProperty('--accent-glow', 'rgba(6, 182, 212, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(6, 182, 212, 0.25) 0%, rgba(11, 15, 25, 0) 70%)';
            } else {
                root.style.setProperty('--accent-primary', '#3b82f6');
                root.style.setProperty('--accent-secondary', '#8b5cf6');
                root.style.setProperty('--accent-glow', 'rgba(59, 130, 246, 0.15)');
                document.querySelector('.main-content').style.background = 'radial-gradient(circle at 50% 0%, rgba(59, 130, 246, 0.2) 0%, rgba(11, 15, 25, 0) 70%)';
            }
            
            // Recompute rankings
            computeBSTRankings();
            
            // Rebuild character list
            initSidebarList();
            
            // Default character
            if (currentGame === "fe5") {
                currentCharacterName = "Leaf";
            } else if (currentGame === "fe8") {
                currentCharacterName = "Eirika";
            } else if (currentGame === "fe7") {
                currentCharacterName = "Eliwood";
            } else if (currentGame === "fe6") {
                currentCharacterName = "Roy";
            } else if (currentGame === "fe9") {
                currentCharacterName = "Ike";
            } else if (currentGame === "fe10") {
                currentCharacterName = "Micaiah";
            } else if (currentGame === "fe11") {
                currentCharacterName = "Marth";
            } else {
                currentCharacterName = "Shiida";
            }
            
            // Redraw dynamic page parts
            renderTableHeaders();
            renderSimTableHeaders();
            renderChartCheckboxes();
            
            loadCharacterDetails(currentCharacterName);
            
            // Redraw leaderboard if it was open
            if (activeTabId === "bst-leaderboard-view") {
                initBSTLeaderboard();
            }
        }

        // --- Initialization ---
        window.addEventListener("DOMContentLoaded", () => {
            const selector = document.getElementById("game-selector");
            const initialGame = selector ? selector.value : "fe5";
            switchGame(initialGame);
            
            // Search filter event listeners
            document.getElementById("search-bar").addEventListener("input", filterSidebarList);
            document.getElementById("filter-gender").addEventListener("change", filterSidebarList);
            document.getElementById("filter-pool").addEventListener("change", filterSidebarList);
        });

        // --- Switch Tabs ---
        function switchTab(viewId, btnEl) {
            document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
            document.querySelectorAll(".view-section").forEach(s => s.classList.remove("active"));
            
            btnEl.classList.add("active");
            document.getElementById(viewId).classList.add("active");
            activeTabId = viewId;
            
            if (viewId === "visual-chart-view") {
                renderSVGChart();
            } else if (viewId === "bst-leaderboard-view") {
                initBSTLeaderboard();
            }
        }

        // --- Render Sidebar List ---
        function initSidebarList() {
            const container = document.getElementById("char-list-container");
            container.innerHTML = "";
            
            Object.keys(activeStatsData).sort().forEach(name => {
                const data = activeStatsData[name];
                
                const item = document.createElement("div");
                item.className = `character-item ${name === currentCharacterName ? 'active' : ''}`;
                item.id = `sidebar-char-${name}`;
                item.onclick = () => loadCharacterDetails(name);
                
                const dotClass = data.is_female ? 'gender-female' : 'gender-male';
                
                item.innerHTML = `
                    <div class="char-item-info">
                        <div class="char-item-name">
                            <span class="char-item-gender-dot ${dotClass}"></span>
                            ${name}
                        </div>
                        <div class="char-item-class">${data.default_class}</div>
                    </div>
                    <span class="char-item-level-badge">Lv ${data.join_lv}</span>
                `;
                container.appendChild(item);
            });
        }

        // --- Filter Sidebar List ---
        function filterSidebarList() {
            const query = document.getElementById("search-bar").value.toLowerCase();
            const genderFilter = document.getElementById("filter-gender").value;
            const poolFilter = document.getElementById("filter-pool").value;
            
            Object.keys(activeStatsData).forEach(name => {
                const data = activeStatsData[name];
                const item = document.getElementById(`sidebar-char-${name}`);
                if (!item) return;
                
                const matchesQuery = name.toLowerCase().includes(query) || data.default_class.toLowerCase().includes(query);
                
                let matchesGender = true;
                if (genderFilter === "female") matchesGender = data.is_female;
                if (genderFilter === "male") matchesGender = !data.is_female;
                
                let matchesPool = true;
                if (poolFilter === "special") {
                    if (currentGame === "fe10") matchesPool = FE10_LAGUZ_CLASSES.has(data.default_class);
                    else if (currentGame === "fe8") matchesPool = FE8_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe7") matchesPool = FE7_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe6") matchesPool = FE6_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe9") matchesPool = FE9_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe5") matchesPool = (data.default_class === "Thief" || data.default_class === "Dancer" || data.default_class === "Bard");
                    else matchesPool = SPECIAL_CLASSES.has(data.default_class);
                } else if (poolFilter === "cavalry") {
                    matchesPool = data.default_class.includes("Pegasus") || data.default_class.includes("Cavalier") || data.default_class.includes("Draco") || data.default_class.includes("Paladin") || data.default_class.includes("Nomad") || data.default_class.includes("Rider") || data.default_class.includes("Valkyri") || data.default_class.includes("Knight") || data.default_class.includes("Ranger") || data.default_class.includes("Falcon");
                } else if (poolFilter === "magic") {
                    matchesPool = data.default_class.includes("Mage") || data.default_class.includes("Cleric") || data.default_class.includes("Curate") || data.default_class.includes("Bishop") || data.default_class.includes("Sage") || data.default_class.includes("Shaman") || data.default_class.includes("Druid") || data.default_class.includes("Priest") || data.default_class.includes("Troubadour") || data.default_class.includes("Monk") || data.default_class.includes("Archsage") || data.default_class.includes("Pupil") || data.default_class.includes("Summoner") || data.default_class.includes("Valkyri") || data.default_class.includes("Necromancer") || data.default_class.includes("Heron");
                } else if (poolFilter === "infantry") {
                    let isSpecial;
                    if (currentGame === "fe10") isSpecial = FE10_LAGUZ_CLASSES.has(data.default_class);
                    else if (currentGame === "fe8") isSpecial = FE8_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe7") isSpecial = FE7_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe6") isSpecial = FE6_SPECIAL_CLASSES.has(data.default_class);
                    else if (currentGame === "fe9") isSpecial = FE9_SPECIAL_CLASSES.has(data.default_class);
                    else isSpecial = SPECIAL_CLASSES.has(data.default_class);
                    
                    matchesPool = !isSpecial && !data.default_class.includes("Pegasus") && !data.default_class.includes("Cavalier") && !data.default_class.includes("Draco") && !data.default_class.includes("Paladin") && !data.default_class.includes("Nomad") && !data.default_class.includes("Rider") && !data.default_class.includes("Mage") && !data.default_class.includes("Cleric") && !data.default_class.includes("Curate") && !data.default_class.includes("Shaman") && !data.default_class.includes("Druid") && !data.default_class.includes("Priest") && !data.default_class.includes("Troubadour") && !data.default_class.includes("Monk") && !data.default_class.includes("Archsage") && !data.default_class.includes("Pupil") && !data.default_class.includes("Summoner") && !data.default_class.includes("Valkyri") && !data.default_class.includes("Necromancer") && !data.default_class.includes("Falcon") && !data.default_class.includes("Ranger") && (!data.default_class.includes("Knight") || data.default_class === "Knight");
                }
                
                if (matchesQuery && matchesGender && matchesPool) {
                    item.style.display = "flex";
                } else {
                    item.style.display = "none";
                }
            });
        }

        // --- Load Character Details ---
        function loadCharacterDetails(name) {
            currentCharacterName = name;
            
            // Update sidebar active classes
            document.querySelectorAll(".character-item").forEach(item => item.classList.remove("active"));
            const activeItem = document.getElementById(`sidebar-char-${name}`);
            if (activeItem) activeItem.classList.add("active");
            
            const rawData = activeRawDb.characters[name];
            
            // Hero Banner Info
            document.getElementById("hero-char-name").innerText = name;
            document.getElementById("hero-gender").innerText = rawData.is_female ? "Female" : "Male";
            document.getElementById("hero-gender").className = `hero-badge hero-badge-gender ${rawData.is_female ? '' : 'male'}`;
            document.getElementById("hero-default-class").innerText = rawData.default_class;
            document.getElementById("hero-join-level").innerText = `Join Level: ${rawData.join_lv}`;
            
            // Render Base Stats & Growth Rates Progress Bars
            renderBasesAndGrowths(rawData);
            
            // Render Reclass Table
            renderReclassTable(name);
            
            // Populate simulator selectors
            initSimulator(name);
            
            // Render Visual Chart
            if (activeTabId === "visual-chart-view") {
                renderSVGChart();
            }
        }

        // --- Render Personal bases & Growths ---
        function renderBasesAndGrowths(rawData) {
            const basesContainer = document.getElementById("personal-bases-container");
            const growthsContainer = document.getElementById("personal-growths-container");
            
            basesContainer.innerHTML = "";
            growthsContainer.innerHTML = "";
            
            STATS.forEach(s => {
                const baseVal = rawData.absolute_bases[s];
                const growthVal = rawData.base_growths[s];
                const color = STAT_COLORS[s];
                
                // Bases (max absolute base is generally around 15, clamp visual max to 18)
                const baseWidth = Math.min(100, (baseVal / 18) * 100);
                basesContainer.innerHTML += `
                    <div class="personal-stat-row">
                        <div class="stat-label-col"><span class="stat-dot" style="background-color: ${color}"></span>${s}</div>
                        <div class="stat-bar-wrapper">
                            <div class="stat-bar-fill" style="background-color: ${color}; width: ${baseWidth}%"></div>
                        </div>
                        <div class="stat-value-col">${baseVal}</div>
                    </div>
                `;
                
                // Growths (max growth can be up to 100%)
                const growthWidth = Math.min(100, growthVal);
                growthsContainer.innerHTML += `
                    <div class="personal-stat-row">
                        <div class="stat-label-col"><span class="stat-dot" style="background-color: ${color}"></span>${s}</div>
                        <div class="stat-bar-wrapper">
                            <div class="stat-bar-fill" style="background-color: ${color}; width: ${growthWidth}%"></div>
                        </div>
                        <div class="stat-value-col">${growthVal}%</div>
                    </div>
                `;
            });
        }

        // --- Helper functions for Sorting and Filtering ---
        function getLevelSortValue(finalLevel) {
            if (finalLevel.includes("10/20/20")) return 50;
            if (finalLevel.includes("20/20")) return 40;
            if (finalLevel.includes("30")) return 30;
            if (finalLevel.includes("20")) return 20;
            return parseFloat(finalLevel) || 0;
        }

        function handleHeaderClick(colKey) {
            if (currentSortColumn === colKey) {
                // Toggle direction
                currentSortOrder = currentSortOrder === "asc" ? "desc" : "asc";
            } else {
                currentSortColumn = colKey;
                // Default to descending for numeric stats/BST so high stats appear at the top immediately!
                currentSortOrder = (colKey === "class") ? "asc" : "desc";
            }
            renderReclassTable(currentCharacterName);
        }

        function updateTableHeaderIcons() {
            const cols = ["class", "level", "bst", "HP", "Str", "Mag", "Skl", "Spd", "Lck", "Def", "Res"];
            cols.forEach(col => {
                const iconEl = document.getElementById(`sort-icon-${col}`);
                if (iconEl) {
                    if (currentSortColumn === col) {
                        iconEl.innerText = currentSortOrder === "asc" ? " ▲" : " ▼";
                        iconEl.style.color = "#fbbf24"; // Amber color to match dashboard accents
                        iconEl.style.fontSize = "0.7rem";
                    } else {
                        iconEl.innerText = "";
                    }
                }
            });
        }

        // --- Render Reclass Table ---
        function renderReclassTable(name) {
            const charData = activeStatsData[name];
            const tbody = document.getElementById("reclass-table-body");
            tbody.innerHTML = "";
            
            const capsDb = activeRawDb.classes.caps;
            const tierFilter = document.getElementById("filter-table-tier") ? document.getElementById("filter-table-tier").value : "all";
            
            // 1. Filter Classes based on selected tier
            let classesList = Object.keys(charData.classes).filter(clsName => {
                if (currentGame === "fe5") {
                    const FE5_PROMOTED_CLASSES = new Set([
                        "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                        "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                        "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                        "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                    ]);
                    if (tierFilter === "promoted") return FE5_PROMOTED_CLASSES.has(clsName) && clsName !== "Dancer";
                    if (tierFilter === "base") return !FE5_PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "special") return clsName === "Dancer";
                } else if (currentGame === "fe10") {
                    if (tierFilter === "promoted") return getFE10ClassTier(clsName) > 1 && !FE10_LAGUZ_CLASSES.has(clsName);
                    if (tierFilter === "base") return getFE10ClassTier(clsName) === 1 && !FE10_LAGUZ_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE10_LAGUZ_CLASSES.has(clsName);
                } else if (currentGame === "fe8") {
                    if (tierFilter === "promoted") return isFE8Promoted(clsName);
                    if (tierFilter === "base") return !isFE8Promoted(clsName) && !FE8_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE8_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe7") {
                    if (tierFilter === "promoted") return isFE7Promoted(clsName);
                    if (tierFilter === "base") return !isFE7Promoted(clsName) && !FE7_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE7_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe6") {
                    if (tierFilter === "promoted") return isFE6Promoted(clsName);
                    if (tierFilter === "base") return !isFE6Promoted(clsName) && !FE6_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE6_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe9") {
                    if (tierFilter === "promoted") return isFE9Promoted(clsName);
                    if (tierFilter === "base") return !isFE9Promoted(clsName) && !FE9_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE9_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe11") {
                    const FE11_PROMOTED_CLASSES = new Set([
                        "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                        "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
                    ]);
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (tierFilter === "promoted") return FE11_PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return FE11_BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE11_SPECIAL_CLASSES.has(clsName);
                } else {
                    if (tierFilter === "promoted") return PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return SPECIAL_CLASSES.has(clsName);
                }
                return true; // "all"
            });
            
            // 2. Sort Classes based on active sorting criteria
            classesList.sort((a, b) => {
                const dataA = charData.classes[a];
                const dataB = charData.classes[b];
                
                let valA, valB;
                
                if (currentSortColumn === "class") {
                    valA = a;
                    valB = b;
                } else if (currentSortColumn === "level") {
                    valA = getLevelSortValue(dataA.final_level);
                    valB = getLevelSortValue(dataB.final_level);
                } else if (currentSortColumn === "bst") {
                    valA = 0;
                    valB = 0;
                    STATS.forEach(s => {
                        valA += dataA.stats[s];
                        valB += dataB.stats[s];
                    });
                } else {
                    valA = dataA.stats[currentSortColumn];
                    valB = dataB.stats[currentSortColumn];
                }
                
                if (currentSortColumn === "class") {
                    if (currentSortOrder === "asc") {
                        return valA.localeCompare(valB);
                    } else {
                        return valB.localeCompare(valA);
                    }
                } else {
                    if (currentSortOrder === "asc") {
                        return valA - valB;
                    } else {
                        return valB - valA;
                    }
                }
            });
            
            // 3. Render Table rows
            classesList.forEach(clsName => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, capsDb);
                
                // Determine Row Style
                const isDefault = clsName === charData.default_class || clsName === getDirectPromotionClass(name);
                const rowClass = isDefault ? 'selected' : '';
                
                const tr = document.createElement("tr");
                tr.className = rowClass;
                
                // Determine Max Level Badge
                let badgeClass = 'promo';
                if (currentGame === "fe5") {
                    const FE5_PROMOTED_CLASSES = new Set([
                        "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                        "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                        "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                        "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                    ]);
                    if (clsName === "Dancer") badgeClass = 'special';
                    else if (!FE5_PROMOTED_CLASSES.has(clsName)) badgeClass = '';
                } else if (currentGame === "fe10") {
                    if (FE10_LAGUZ_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (getFE10ClassTier(clsName) === 1) badgeClass = '';
                } else if (currentGame === "fe8") {
                    if (FE8_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE8Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe7") {
                    if (FE7_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE7Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe6") {
                    if (FE6_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE6Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe9") {
                    if (FE9_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE9Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe11") {
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (FE11_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (FE11_BASE_CLASSES.has(clsName)) badgeClass = '';
                } else {
                    if (SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (BASE_CLASSES.has(clsName)) badgeClass = '';
                }
                
                // Calculate BST
                let bst = 0;
                STATS.forEach(s => { bst += clsData.stats[s]; });
                
                let tdHTML = `
                    <td>
                        <div class="class-td-name" onclick="selectClassForSimulator('${clsName}')">${clsName}</div>
                        <div class="class-td-path">${clsData.class_path}</div>
                    </td>
                    <td><span class="max-lv-badge ${badgeClass}">${clsData.final_level}</span></td>
                    <td style="font-weight: 700; color: #fbbf24;">${bst.toFixed(1)}</td>
                `;
                
                STATS.forEach(s => {
                    const statVal = clsData.stats[s];
                    const capVal = classCaps[s];
                    const isCapped = statVal >= capVal;
                    
                    tdHTML += `
                        <td class="${isCapped ? 'cap-cell' : ''}">
                            ${statVal.toFixed(1)}
                            ${isCapped ? '<span style="font-size:0.6rem; vertical-align:middle; margin-left:2px;">★</span>' : ''}
                        </td>
                    `;
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
            
            // 4. Update column sort icons in table header
            updateTableHeaderIcons();
        }

        // --- Visual SVG Chart ---
        function toggleChartStat(s) {
            const chk = document.getElementById(`chk-${s}`);
            if (!chk) return;
            checkedChartStats[s] = chk.checked;
            const el = document.getElementById(`lbl-chk-${s}`);
            if (el) {
                if (checkedChartStats[s]) {
                    el.classList.add("checked");
                } else {
                    el.classList.remove("checked");
                }
            }
            renderSVGChart();
        }

        function renderSVGChart() {
            const svg = document.getElementById("svg-comparison-chart");
            svg.innerHTML = "";
            
            const charData = activeStatsData[currentCharacterName];
            const validClasses = Object.keys(charData.classes).sort();
            
            const activeStats = STATS.filter(s => checkedChartStats[s]);
            
            if (activeStats.length === 0 || validClasses.length === 0) {
                svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" fill="var(--text-secondary)">Select at least one stat to view the chart comparison</text>`;
                return;
            }
            
            const margin = { top: 40, right: 30, bottom: 80, left: 180 };
            const chartWidth = svg.clientWidth - margin.left - margin.right;
            const chartHeight = 420 - margin.top - margin.bottom;
            
            // X-Scale: Stat Value (dynamic, up to 80 for FE5)
            let maxVal = 60;
            if (currentGame === "fe5") {
                maxVal = 80;
            }
            const x = (val) => (val / maxVal) * chartWidth;
            
            // Y-Scale: Classes
            const numClasses = validClasses.length;
            const rowHeight = chartHeight / numClasses;
            const barHeight = rowHeight * 0.75;
            
            // Draw Gridlines
            for (let i = 10; i <= maxVal; i += 10) {
                const xPos = margin.left + x(i);
                svg.innerHTML += `
                    <line x1="${xPos}" y1="${margin.top}" x2="${xPos}" y2="${margin.top + chartHeight}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                    <text x="${xPos}" y="${margin.top + chartHeight + 18}" text-anchor="middle" fill="var(--text-secondary)" font-size="0.75rem">${i}</text>
                `;
            }
            
            // Draw Classes and Bars
            validClasses.forEach((clsName, idx) => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, activeRawDb.classes.caps);
                const yPos = margin.top + (idx * rowHeight);
                
                // Draw Class Name
                svg.innerHTML += `
                    <text x="${margin.left - 12}" y="${yPos + (barHeight/2) + 4}" text-anchor="end" fill="var(--text-primary)" font-size="0.85rem" font-family="'Outfit', sans-serif">${clsName}</text>
                `;
                
                // Draw stacked bars
                let xAccum = 0;
                const activeNum = activeStats.length;
                const subBarHeight = barHeight / activeNum;
                
                activeStats.forEach((s, sIdx) => {
                    const val = clsData.stats[s];
                    const color = STAT_COLORS[s];
                    const barW = x(val);
                    const subY = yPos + (sIdx * subBarHeight);
                    const isCapped = val >= classCaps[s];
                    
                    svg.innerHTML += `
                        <rect x="${margin.left}" y="${subY}" width="${barW}" height="${subBarHeight - 1}" fill="${color}" opacity="0.85" rx="1.5">
                            <title>${clsName} ${s}: ${val.toFixed(1)} ${isCapped ? '(CAPPED)' : ''}</title>
                        </rect>
                    `;
                });
            });
            
            // Render Legend at bottom
            const legendY = 420 - 20;
            let legendX = margin.left;
            activeStats.forEach(s => {
                const color = STAT_COLORS[s];
                svg.innerHTML += `
                    <rect x="${legendX}" y="${legendY - 10}" width="12" height="12" fill="${color}" rx="2" />
                    <text x="${legendX + 18}" y="${legendY}" fill="var(--text-primary)" font-size="0.8rem" font-weight="500" style="margin-right:20px;">${s}</text>
                `;
                legendX += 80;
            });
        }

        // --- Simulator System ---
        function initSimulator(charName) {
            const charData = activeStatsData[charName];
            const container = document.getElementById("sim-class-list-container");
            container.innerHTML = "";
            
            const validClasses = Object.keys(charData.classes).sort();
            
            // Auto-select first class
            selectedSimClass = validClasses.includes("Falcon Knight") ? "Falcon Knight" : (validClasses.includes("Paladin") ? "Paladin" : validClasses[0]);
            
            validClasses.forEach(cls => {
                const isDefault = cls === charData.default_class || (charData.default_class === "Pegasus Knight" && cls === "Falcon Knight");
                const item = document.createElement("div");
                item.className = `sim-class-item ${cls === selectedSimClass ? 'active' : ''}`;
                item.id = `sim-cls-item-${cls}`;
                item.onclick = () => selectClassForSimulator(cls);
                
                item.innerHTML = `
                    <span>${cls}</span>
                    <span style="font-size:0.7rem; opacity:0.6;">${isDefault ? 'Default' : ''}</span>
                `;
                container.appendChild(item);
            });
            
            runSimulatorSimulation();
        }

        function selectClassForSimulator(clsName) {
            selectedSimClass = clsName;
            document.querySelectorAll(".sim-class-item").forEach(item => item.classList.remove("active"));
            const el = document.getElementById(`sim-cls-item-${clsName}`);
            if (el) el.classList.add("active");
            
            // Switch tabs if selected from the table view
            const tabBtn = document.querySelector(".tabs-container button:nth-child(3)");
            switchTab('simulator-view', tabBtn);
            
            runSimulatorSimulation();
        }

        function runSimulatorSimulation() {
            const calc = calculateAvgStatsJS(currentCharacterName, selectedSimClass);
            
            document.getElementById("sim-log-title").innerText = `Level-up Growth Log: ${currentCharacterName} as ${selectedSimClass}`;
            document.getElementById("sim-log-desc").innerText = `Calculated Path: ${calc.classPath} (Final Max Level: ${calc.finalLevel})`;
            
            const tbody = document.getElementById("sim-table-body");
            tbody.innerHTML = "";
            
            const capsDb = activeRawDb.classes.caps;
            
            calc.history.forEach((row, rIdx) => {
                const [lvStr, clsName, stats] = row;
                const isPromo = lvStr === "Promotion" || lvStr === "20/1";
                
                const classCaps = getCapsForClass(clsName, capsDb);
                
                const tr = document.createElement("tr");
                if (lvStr === "Promotion") {
                    tr.className = "promo-row";
                }
                
                let tdHTML = `
                    <td>${lvStr}</td>
                    <td>${clsName}</td>
                `;
                
                STATS.forEach(s => {
                    const val = stats[s];
                    const cap = classCaps[s];
                    const isCapped = val >= cap;
                    
                    if (lvStr === "Promotion") {
                        // Just display promotion differentials
                        const prevStats = calc.history[rIdx - 1][2];
                        const diff = val - prevStats[s];
                        const diffStr = diff >= 0 ? `+${diff}` : `${diff}`;
                        tdHTML += `<td style="font-weight:700;">${diffStr}</td>`;
                    } else {
                        tdHTML += `
                            <td class="${isCapped ? 'cap-cell' : ''}">
                                ${val.toFixed(2)}
                                ${isCapped ? '<span class="sim-cap-badge">CAP</span>' : ''}
                            </td>
                        `;
                    }
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
        }
                    }
            });
        }

        // --- Render Reclass Table ---
        function renderReclassTable(name) {
            const charData = activeStatsData[name];
            const tbody = document.getElementById("reclass-table-body");
            tbody.innerHTML = "";
            
            const capsDb = activeRawDb.classes.caps;
            const tierFilter = document.getElementById("filter-table-tier") ? document.getElementById("filter-table-tier").value : "all";
            
            // 1. Filter Classes based on selected tier
            let classesList = Object.keys(charData.classes).filter(clsName => {
                if (currentGame === "fe5") {
                    const FE5_PROMOTED_CLASSES = new Set([
                        "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                        "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                        "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                        "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                    ]);
                    if (tierFilter === "promoted") return FE5_PROMOTED_CLASSES.has(clsName) && clsName !== "Dancer";
                    if (tierFilter === "base") return !FE5_PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "special") return clsName === "Dancer";
                } else if (currentGame === "fe10") {
                    if (tierFilter === "promoted") return getFE10ClassTier(clsName) > 1 && !FE10_LAGUZ_CLASSES.has(clsName);
                    if (tierFilter === "base") return getFE10ClassTier(clsName) === 1 && !FE10_LAGUZ_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE10_LAGUZ_CLASSES.has(clsName);
                } else if (currentGame === "fe8") {
                    if (tierFilter === "promoted") return isFE8Promoted(clsName);
                    if (tierFilter === "base") return !isFE8Promoted(clsName) && !FE8_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE8_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe7") {
                    if (tierFilter === "promoted") return isFE7Promoted(clsName);
                    if (tierFilter === "base") return !isFE7Promoted(clsName) && !FE7_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE7_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe6") {
                    if (tierFilter === "promoted") return isFE6Promoted(clsName);
                    if (tierFilter === "base") return !isFE6Promoted(clsName) && !FE6_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE6_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe9") {
                    if (tierFilter === "promoted") return isFE9Promoted(clsName);
                    if (tierFilter === "base") return !isFE9Promoted(clsName) && !FE9_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE9_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe11") {
                    const FE11_PROMOTED_CLASSES = new Set([
                        "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                        "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
                    ]);
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (tierFilter === "promoted") return FE11_PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return FE11_BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE11_SPECIAL_CLASSES.has(clsName);
                } else {
                    if (tierFilter === "promoted") return PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return SPECIAL_CLASSES.has(clsName);
                }
                return true; // "all"
            });
            
            // 2. Sort Classes based on active sorting criteria
            classesList.sort((a, b) => {
                const dataA = charData.classes[a];
                const dataB = charData.classes[b];
                
                let valA, valB;
                
                if (currentSortColumn === "class") {
                    valA = a;
                    valB = b;
                } else if (currentSortColumn === "level") {
                    valA = getLevelSortValue(dataA.final_level);
                    valB = getLevelSortValue(dataB.final_level);
                } else if (currentSortColumn === "bst") {
                    valA = 0;
                    valB = 0;
                    STATS.forEach(s => {
                        valA += dataA.stats[s];
                        valB += dataB.stats[s];
                    });
                } else {
                    valA = dataA.stats[currentSortColumn];
                    valB = dataB.stats[currentSortColumn];
                }
                
                if (currentSortColumn === "class") {
                    if (currentSortOrder === "asc") {
                        return valA.localeCompare(valB);
                    } else {
                        return valB.localeCompare(valA);
                    }
                } else {
                    if (currentSortOrder === "asc") {
                        return valA - valB;
                    } else {
                        return valB - valA;
                    }
                }
            });
            
            // 3. Render Table rows
            classesList.forEach(clsName => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, capsDb);
                
                // Determine Row Style
                const isDefault = clsName === charData.default_class || clsName === getDirectPromotionClass(name);
                const rowClass = isDefault ? 'selected' : '';
                
                const tr = document.createElement("tr");
                tr.className = rowClass;
                
                // Determine Max Level Badge
                let badgeClass = 'promo';
                if (currentGame === "fe5") {
                    const FE5_PROMOTED_CLASSES = new Set([
                        "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                        "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                        "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                        "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                    ]);
                    if (clsName === "Dancer") badgeClass = 'special';
                    else if (!FE5_PROMOTED_CLASSES.has(clsName)) badgeClass = '';
                } else if (currentGame === "fe10") {
                    if (FE10_LAGUZ_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (getFE10ClassTier(clsName) === 1) badgeClass = '';
                } else if (currentGame === "fe8") {
                    if (FE8_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE8Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe7") {
                    if (FE7_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE7Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe6") {
                    if (FE6_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE6Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe9") {
                    if (FE9_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE9Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe11") {
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (FE11_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (FE11_BASE_CLASSES.has(clsName)) badgeClass = '';
                } else {
                    if (SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (BASE_CLASSES.has(clsName)) badgeClass = '';
                }
                
                // Calculate BST
                let bst = 0;
                STATS.forEach(s => { bst += clsData.stats[s]; });
                
                let tdHTML = `
                    <td>
                        <div class="class-td-name" onclick="selectClassForSimulator('${clsName}')">${clsName}</div>
                        <div class="class-td-path">${clsData.class_path}</div>
                    </td>
                    <td><span class="max-lv-badge ${badgeClass}">${clsData.final_level}</span></td>
                    <td style="font-weight: 700; color: #fbbf24;">${bst.toFixed(1)}</td>
                `;
                
                STATS.forEach(s => {
                    const statVal = clsData.stats[s];
                    const capVal = classCaps[s];
                    const isCapped = statVal >= capVal;
                    
                    tdHTML += `
                        <td class="${isCapped ? 'cap-cell' : ''}">
                            ${statVal.toFixed(1)}
                            ${isCapped ? '<span style="font-size:0.6rem; vertical-align:middle; margin-left:2px;">★</span>' : ''}
                        </td>
                    `;
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
            
            // 4. Update column sort icons in table header
            updateTableHeaderIcons();
        }

        // --- Visual SVG Chart ---
        function toggleChartStat(s) {
            const chk = document.getElementById(`chk-${s}`);
            if (!chk) return;
            checkedChartStats[s] = chk.checked;
            const el = document.getElementById(`lbl-chk-${s}`);
            if (el) {
                if (checkedChartStats[s]) {
                    el.classList.add("checked");
                } else {
                    el.classList.remove("checked");
                }
            }
            renderSVGChart();
        }

        function renderSVGChart() {
            const svg = document.getElementById("svg-comparison-chart");
            svg.innerHTML = "";
            
            const charData = activeStatsData[currentCharacterName];
            const validClasses = Object.keys(charData.classes).sort();
            
            const activeStats = STATS.filter(s => checkedChartStats[s]);
            
            if (activeStats.length === 0 || validClasses.length === 0) {
                svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" fill="var(--text-secondary)">Select at least one stat to view the chart comparison</text>`;
                return;
            }
            
            const margin = { top: 40, right: 30, bottom: 80, left: 180 };
            const chartWidth = svg.clientWidth - margin.left - margin.right;
            const chartHeight = 420 - margin.top - margin.bottom;
            
            // X-Scale: Stat Value (dynamic, up to 80 for FE5)
            let maxVal = 60;
            if (currentGame === "fe5") {
                maxVal = 80;
            }
            const x = (val) => (val / maxVal) * chartWidth;
            
            // Y-Scale: Classes
            const numClasses = validClasses.length;
            const rowHeight = chartHeight / numClasses;
            const barHeight = rowHeight * 0.75;
            
            // Draw Gridlines
            for (let i = 10; i <= maxVal; i += 10) {
                const xPos = margin.left + x(i);
                svg.innerHTML += `
                    <line x1="${xPos}" y1="${margin.top}" x2="${xPos}" y2="${margin.top + chartHeight}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                    <text x="${xPos}" y="${margin.top + chartHeight + 18}" text-anchor="middle" fill="var(--text-secondary)" font-size="0.75rem">${i}</text>
                `;
            }
            
            // Draw Classes and Bars
            validClasses.forEach((clsName, idx) => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, activeRawDb.classes.caps);
                const yPos = margin.top + (idx * rowHeight);
                
                // Draw Class Name
                svg.innerHTML += `
                    <text x="${margin.left - 12}" y="${yPos + (barHeight/2) + 4}" text-anchor="end" fill="var(--text-primary)" font-size="0.85rem" font-family="'Outfit', sans-serif">${clsName}</text>
                `;
                
                // Draw stacked bars
                let xAccum = 0;
                const activeNum = activeStats.length;
                const subBarHeight = barHeight / activeNum;
                
                activeStats.forEach((s, sIdx) => {
                    const val = clsData.stats[s];
                    const color = STAT_COLORS[s];
                    const barW = x(val);
                    const subY = yPos + (sIdx * subBarHeight);
                    const isCapped = val >= classCaps[s];
                    
                    svg.innerHTML += `
                        <rect x="${margin.left}" y="${subY}" width="${barW}" height="${subBarHeight - 1}" fill="${color}" opacity="0.85" rx="1.5">
                            <title>${clsName} ${s}: ${val.toFixed(1)} ${isCapped ? '(CAPPED)' : ''}</title>
                        </rect>
                    `;
                });
            });
            
            // Render Legend at bottom
            const legendY = 420 - 20;
            let legendX = margin.left;
            activeStats.forEach(s => {
                const color = STAT_COLORS[s];
                svg.innerHTML += `
                    <rect x="${legendX}" y="${legendY - 10}" width="12" height="12" fill="${color}" rx="2" />
                    <text x="${legendX + 18}" y="${legendY}" fill="var(--text-primary)" font-size="0.8rem" font-weight="500" style="margin-right:20px;">${s}</text>
                `;
                legendX += 80;
            });
        }

        // --- Simulator System ---
        function initSimulator(charName) {
            const charData = activeStatsData[charName];
            const container = document.getElementById("sim-class-list-container");
            container.innerHTML = "";
            
            const validClasses = Object.keys(charData.classes).sort();
            
            // Auto-select first class
            selectedSimClass = validClasses.includes("Falcon Knight") ? "Falcon Knight" : (validClasses.includes("Paladin") ? "Paladin" : validClasses[0]);
            
            validClasses.forEach(cls => {
                const isDefault = cls === charData.default_class || (charData.default_class === "Pegasus Knight" && cls === "Falcon Knight");
                const item = document.createElement("div");
                item.className = `sim-class-item ${cls === selectedSimClass ? 'active' : ''}`;
                item.id = `sim-cls-item-${cls}`;
                item.onclick = () => selectClassForSimulator(cls);
                
                item.innerHTML = `
                    <span>${cls}</span>
                    <span style="font-size:0.7rem; opacity:0.6;">${isDefault ? 'Default' : ''}</span>
                `;
                container.appendChild(item);
            });
            
            runSimulatorSimulation();
        }

        function selectClassForSimulator(clsName) {
            selectedSimClass = clsName;
            document.querySelectorAll(".sim-class-item").forEach(item => item.classList.remove("active"));
            const el = document.getElementById(`sim-cls-item-${clsName}`);
            if (el) el.classList.add("active");
            
            // Switch tabs if selected from the table view
            const tabBtn = document.querySelector(".tabs-container button:nth-child(3)");
            switchTab('simulator-view', tabBtn);
            
            runSimulatorSimulation();
        }

        function runSimulatorSimulation() {
            const calc = calculateAvgStatsJS(currentCharacterName, selectedSimClass);
            
            document.getElementById("sim-log-title").innerText = `Level-up Growth Log: ${currentCharacterName} as ${selectedSimClass}`;
            document.getElementById("sim-log-desc").innerText = `Calculated Path: ${calc.classPath} (Final Max Level: ${calc.finalLevel})`;
            
            const tbody = document.getElementById("sim-table-body");
            tbody.innerHTML = "";
            
            const capsDb = activeRawDb.classes.caps;
            
            calc.history.forEach((row, rIdx) => {
                const [lvStr, clsName, stats] = row;
                const isPromo = lvStr === "Promotion" || lvStr === "20/1";
                
                const classCaps = getCapsForClass(clsName, capsDb);
                
                const tr = document.createElement("tr");
                if (lvStr === "Promotion") {
                    tr.className = "promo-row";
                }
                
                let tdHTML = `
                    <td>${lvStr}</td>
                    <td>${clsName}</td>
                `;
                
                STATS.forEach(s => {
                    const val = stats[s];
                    const cap = classCaps[s];
                    const isCapped = val >= cap;
                    
                    if (lvStr === "Promotion") {
                        // Just display promotion differentials
                        const prevStats = calc.history[rIdx - 1][2];
                        const diff = val - prevStats[s];
                        const diffStr = diff >= 0 ? `+${diff}` : `${diff}`;
                        tdHTML += `<td style="font-weight:700;">${diffStr}</td>`;
                    } else {
                        tdHTML += `
                            <td class="${isCapped ? 'cap-cell' : ''}">
                                ${val.toFixed(2)}
                                ${isCapped ? '<span class="sim-cap-badge">CAP</span>' : ''}
                            </td>
                        `;
                    }
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
        }
                        if (tierFilter === "special") return FE8_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe7") {
                    if (tierFilter === "promoted") return isFE7Promoted(clsName);
                    if (tierFilter === "base") return !isFE7Promoted(clsName) && !FE7_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE7_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe6") {
                    if (tierFilter === "promoted") return isFE6Promoted(clsName);
                    if (tierFilter === "base") return !isFE6Promoted(clsName) && !FE6_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE6_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe9") {
                    if (tierFilter === "promoted") return isFE9Promoted(clsName);
                    if (tierFilter === "base") return !isFE9Promoted(clsName) && !FE9_SPECIAL_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE9_SPECIAL_CLASSES.has(clsName);
                } else if (currentGame === "fe11") {
                    const FE11_PROMOTED_CLASSES = new Set([
                        "Falcon Knight", "Dracoknight", "Paladin", "Sniper", "Swordmaster", 
                        "Sage", "Bishop", "General", "Hero", "Warrior", "Horseman", "Berserker", "Sorcerer"
                    ]);
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (tierFilter === "promoted") return FE11_PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return FE11_BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return FE11_SPECIAL_CLASSES.has(clsName);
                } else {
                    if (tierFilter === "promoted") return PROMOTED_CLASSES.has(clsName);
                    if (tierFilter === "base") return BASE_CLASSES.has(clsName);
                    if (tierFilter === "special") return SPECIAL_CLASSES.has(clsName);
                }
                return true; // "all"
            });
            
            // 2. Sort Classes based on active sorting criteria
            classesList.sort((a, b) => {
                const dataA = charData.classes[a];
                const dataB = charData.classes[b];
                
                let valA, valB;
                
                if (currentSortColumn === "class") {
                    valA = a;
                    valB = b;
                } else if (currentSortColumn === "level") {
                    valA = getLevelSortValue(dataA.final_level);
                    valB = getLevelSortValue(dataB.final_level);
                } else if (currentSortColumn === "bst") {
                    valA = 0;
                    valB = 0;
                    STATS.forEach(s => {
                        valA += dataA.stats[s];
                        valB += dataB.stats[s];
                    });
                } else {
                    valA = dataA.stats[currentSortColumn];
                    valB = dataB.stats[currentSortColumn];
                }
                
                if (currentSortColumn === "class") {
                    if (currentSortOrder === "asc") {
                        return valA.localeCompare(valB);
                    } else {
                        return valB.localeCompare(valA);
                    }
                } else {
                    if (currentSortOrder === "asc") {
                        return valA - valB;
                    } else {
                        return valB - valA;
                    }
                }
            });
            
            // 3. Render Table rows
            classesList.forEach(clsName => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, capsDb);
                
                // Determine Row Style
                const isDefault = clsName === charData.default_class || clsName === getDirectPromotionClass(name);
                const rowClass = isDefault ? 'selected' : '';
                
                const tr = document.createElement("tr");
                tr.className = rowClass;
                
                // Determine Max Level Badge
                let badgeClass = 'promo';
                if (currentGame === "fe5") {
                    const FE5_PROMOTED_CLASSES = new Set([
                        "Prince", "Paladin", "Forrest Knight", "Duke Knight", "Great Knight", 
                        "General", "Mercenary", "Swordmaster", "Sniper", "Bow Knight", 
                        "Warrior", "Pegasus Knight", "Dragon Knight", "High Priest", "Sage", 
                        "Mage Knight", "Dark Mage", "Thief Fighter", "Dancer"
                    ]);
                    if (clsName === "Dancer") badgeClass = 'special';
                    else if (!FE5_PROMOTED_CLASSES.has(clsName)) badgeClass = '';
                } else if (currentGame === "fe10") {
                    if (FE10_LAGUZ_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (getFE10ClassTier(clsName) === 1) badgeClass = '';
                } else if (currentGame === "fe8") {
                    if (FE8_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE8Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe7") {
                    if (FE7_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE7Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe6") {
                    if (FE6_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE6Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe9") {
                    if (FE9_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (!isFE9Promoted(clsName)) badgeClass = '';
                } else if (currentGame === "fe11") {
                    const FE11_BASE_CLASSES = new Set([
                        "Pegasus Knight", "Cavalier", "Archer", "Myrmidon", "Mage", "Cleric", "Curate",
                        "Knight", "Mercenary", "Fighter", "Hunter", "Pirate", "Dark Mage"
                    ]);
                    const FE11_SPECIAL_CLASSES = new Set([
                        "Lord", "Thief", "Manakete", "Ballistician", "Chameleon"
                    ]);
                    if (FE11_SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (FE11_BASE_CLASSES.has(clsName)) badgeClass = '';
                } else {
                    if (SPECIAL_CLASSES.has(clsName)) badgeClass = 'special';
                    else if (BASE_CLASSES.has(clsName)) badgeClass = '';
                }
                
                // Calculate BST
                let bst = 0;
                STATS.forEach(s => { bst += clsData.stats[s]; });
                
                let tdHTML = `
                    <td>
                        <div class="class-td-name" onclick="selectClassForSimulator('${clsName}')">${clsName}</div>
                        <div class="class-td-path">${clsData.class_path}</div>
                    </td>
                    <td><span class="max-lv-badge ${badgeClass}">${clsData.final_level}</span></td>
                    <td style="font-weight: 700; color: #fbbf24;">${bst.toFixed(1)}</td>
                `;
                
                STATS.forEach(s => {
                    const statVal = clsData.stats[s];
                    const capVal = classCaps[s];
                    const isCapped = statVal >= capVal;
                    
                    tdHTML += `
                        <td class="${isCapped ? 'cap-cell' : ''}">
                            ${statVal.toFixed(1)}
                            ${isCapped ? '<span style="font-size:0.6rem; vertical-align:middle; margin-left:2px;">★</span>' : ''}
                        </td>
                    `;
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
            
            // 4. Update column sort icons in table header
            updateTableHeaderIcons();
        }

        // --- Visual SVG Chart ---
        function toggleChartStat(s) {
            const chk = document.getElementById(`chk-${s}`);
            if (!chk) return;
            checkedChartStats[s] = chk.checked;
            const el = document.getElementById(`lbl-chk-${s}`);
            if (el) {
                if (checkedChartStats[s]) {
                    el.classList.add("checked");
                } else {
                    el.classList.remove("checked");
                }
            }
            renderSVGChart();
        }

        function renderSVGChart() {
            const svg = document.getElementById("svg-comparison-chart");
            svg.innerHTML = "";
            
            const charData = activeStatsData[currentCharacterName];
            const validClasses = Object.keys(charData.classes).sort();
            
            const activeStats = STATS.filter(s => checkedChartStats[s]);
            
            if (activeStats.length === 0 || validClasses.length === 0) {
                svg.innerHTML = `<text x="50%" y="50%" text-anchor="middle" fill="var(--text-secondary)">Select at least one stat to view the chart comparison</text>`;
                return;
            }
            
            const margin = { top: 40, right: 30, bottom: 80, left: 180 };
            const chartWidth = svg.clientWidth - margin.left - margin.right;
            const chartHeight = 420 - margin.top - margin.bottom;
            
            // X-Scale: Stat Value (dynamic, up to 80 for FE5)
            let maxVal = 60;
            if (currentGame === "fe5") {
                maxVal = 80;
            }
            const x = (val) => (val / maxVal) * chartWidth;
            
            // Y-Scale: Classes
            const numClasses = validClasses.length;
            const rowHeight = chartHeight / numClasses;
            const barHeight = rowHeight * 0.75;
            
            // Draw Gridlines
            for (let i = 10; i <= maxVal; i += 10) {
                const xPos = margin.left + x(i);
                svg.innerHTML += `
                    <line x1="${xPos}" y1="${margin.top}" x2="${xPos}" y2="${margin.top + chartHeight}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                    <text x="${xPos}" y="${margin.top + chartHeight + 18}" text-anchor="middle" fill="var(--text-secondary)" font-size="0.75rem">${i}</text>
                `;
            }
            
            // Draw Classes and Bars
            validClasses.forEach((clsName, idx) => {
                const clsData = charData.classes[clsName];
                const classCaps = getCapsForClass(clsName, activeRawDb.classes.caps);
                const yPos = margin.top + (idx * rowHeight);
                
                // Draw Class Name
                svg.innerHTML += `
                    <text x="${margin.left - 12}" y="${yPos + (barHeight/2) + 4}" text-anchor="end" fill="var(--text-primary)" font-size="0.85rem" font-family="'Outfit', sans-serif">${clsName}</text>
                `;
                
                // Draw stacked bars
                let xAccum = 0;
                const activeNum = activeStats.length;
                const subBarHeight = barHeight / activeNum;
                
                activeStats.forEach((s, sIdx) => {
                    const val = clsData.stats[s];
                    const color = STAT_COLORS[s];
                    const barW = x(val);
                    const subY = yPos + (sIdx * subBarHeight);
                    const isCapped = val >= classCaps[s];
                    
                    svg.innerHTML += `
                        <rect x="${margin.left}" y="${subY}" width="${barW}" height="${subBarHeight - 1}" fill="${color}" opacity="0.85" rx="1.5">
                            <title>${clsName} ${s}: ${val.toFixed(1)} ${isCapped ? '(CAPPED)' : ''}</title>
                        </rect>
                    `;
                });
            });
            
            // Render Legend at bottom
            const legendY = 420 - 20;
            let legendX = margin.left;
            activeStats.forEach(s => {
                const color = STAT_COLORS[s];
                svg.innerHTML += `
                    <rect x="${legendX}" y="${legendY - 10}" width="12" height="12" fill="${color}" rx="2" />
                    <text x="${legendX + 18}" y="${legendY}" fill="var(--text-primary)" font-size="0.8rem" font-weight="500" style="margin-right:20px;">${s}</text>
                `;
                legendX += 80;
            });
        }

        // --- Simulator System ---
        function initSimulator(charName) {
            const charData = activeStatsData[charName];
            const container = document.getElementById("sim-class-list-container");
            container.innerHTML = "";
            
            const validClasses = Object.keys(charData.classes).sort();
            
            // Auto-select first class
            selectedSimClass = validClasses.includes("Falcon Knight") ? "Falcon Knight" : (validClasses.includes("Paladin") ? "Paladin" : validClasses[0]);
            
            validClasses.forEach(cls => {
                const isDefault = cls === charData.default_class || (charData.default_class === "Pegasus Knight" && cls === "Falcon Knight");
                const item = document.createElement("div");
                item.className = `sim-class-item ${cls === selectedSimClass ? 'active' : ''}`;
                item.id = `sim-cls-item-${cls}`;
                item.onclick = () => selectClassForSimulator(cls);
                
                item.innerHTML = `
                    <span>${cls}</span>
                    <span style="font-size:0.7rem; opacity:0.6;">${isDefault ? 'Default' : ''}</span>
                `;
                container.appendChild(item);
            });
            
            runSimulatorSimulation();
        }

        function selectClassForSimulator(clsName) {
            selectedSimClass = clsName;
            document.querySelectorAll(".sim-class-item").forEach(item => item.classList.remove("active"));
            const el = document.getElementById(`sim-cls-item-${clsName}`);
            if (el) el.classList.add("active");
            
            // Switch tabs if selected from the table view
            const tabBtn = document.querySelector(".tabs-container button:nth-child(3)");
            switchTab('simulator-view', tabBtn);
            
            runSimulatorSimulation();
        }

        function runSimulatorSimulation() {
            const calc = calculateAvgStatsJS(currentCharacterName, selectedSimClass);
            
            document.getElementById("sim-log-title").innerText = `Level-up Growth Log: ${currentCharacterName} as ${selectedSimClass}`;
            document.getElementById("sim-log-desc").innerText = `Calculated Path: ${calc.classPath} (Final Max Level: ${calc.finalLevel})`;
            
            const tbody = document.getElementById("sim-table-body");
            tbody.innerHTML = "";
            
            const capsDb = activeRawDb.classes.caps;
            
            calc.history.forEach((row, rIdx) => {
                const [lvStr, clsName, stats] = row;
                const isPromo = lvStr === "Promotion" || lvStr === "20/1";
                
                const classCaps = getCapsForClass(clsName, capsDb);
                
                const tr = document.createElement("tr");
                if (lvStr === "Promotion") {
                    tr.className = "promo-row";
                }
                
                let tdHTML = `
                    <td>${lvStr}</td>
                    <td>${clsName}</td>
                `;
                
                STATS.forEach(s => {
                    const val = stats[s];
                    const cap = classCaps[s];
                    const isCapped = val >= cap;
                    
                    if (lvStr === "Promotion") {
                        // Just display promotion differentials
                        const prevStats = calc.history[rIdx - 1][2];
                        const diff = val - prevStats[s];
                        const diffStr = diff >= 0 ? `+${diff}` : `${diff}`;
                        tdHTML += `<td style="font-weight:700;">${diffStr}</td>`;
                    } else {
                        tdHTML += `
                            <td class="${isCapped ? 'cap-cell' : ''}">
                                ${val.toFixed(2)}
                                ${isCapped ? '<span class="sim-cap-badge">CAP</span>' : ''}
                            </td>
                        `;
                    }
                });
                
                tr.innerHTML = tdHTML;
                tbody.appendChild(tr);
            });
        }
    